#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$(dirname "$SCRIPT_DIR")/.venv"

if [ -d "$VENV_DIR" ]; then
  # shellcheck disable=SC1090
  source "$VENV_DIR/bin/activate"
fi

if [[ $# -lt 1 ]]; then
  echo "Usage: scripts/zoo <command> [args...]"
  echo ""
  echo "Commands:"
  echo "  download <name-frag>  Download model and checkpoint from MLflow run matching name fragment"
  exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
  download)
    exec python -m scripts.zoo_download "$@"
    ;;
  *)
    echo "Unknown command: $COMMAND"
    echo "Usage: scripts/zoo <command> [args...]"
    echo "  download <name-frag>"
    exit 1
    ;;
esac
