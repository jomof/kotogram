from rich.console import Console
from rich.progress import Progress

# Ensure we can import from local modules
if os.path.basename(os.getcwd()) == "scripts":
    sys.path.append(os.path.dirname(os.getcwd()))
elif os.path.exists("scripts"):
    # Prepend to path to ensure local modules override installed ones
    sys.path.insert(0, os.getcwd())

from kotogram.analysis import RegisterLevel
from scripts.progress_utils import create_progress
from kotogram.constants import (
    REGISTER_LABEL_TO_ID,
)
from kotogram.kotogram import kotogram_to_japanese
from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
from scripts.rule_based_analysis import (
    analyze_formality,
    analyze_gender,
    analyze_register,
    formality_to_weight,
    infer_gender_from_register,
    load_register_overrides,
)
