console = Console()

# Global variables for workers
_WORKER_OVERRIDES: Dict[str, Any] = None


def init_worker(overrides: Dict[str, Any]):
    """Initialize worker process."""
    global _WORKER_OVERRIDES
    _WORKER_OVERRIDES = overrides


def analyze_chunk(chunk: List[Tuple[str, int]]) -> List[Tuple]:
    """Analyze a chunk of sentences."""
    results = []
    
    # Cache constants
    NEUTRAL_R_ID = REGISTER_LABEL_TO_ID[RegisterLevel.NEUTRAL]
    
    # Instantiate parser per chunk for resilience (matches label.py)
    # Instantiate parser per chunk for resilience (matches label.py)
    parser = SudachiJapaneseParser()
    
    for sent, gram in chunk:
        kotogram = parser.japanese_to_kotogram(sent)
        
        # Normalize sentence to match tokenizer pipeline (e.g. "…" -> "...")
        normalized_sent = kotogram_to_japanese(kotogram)
            
        # Analysis
        f_enum = analyze_formality(kotogram)
        g_enum = analyze_gender(kotogram)
        
        # Reg overrides - key by normalized or raw?
        # Overrides loaded from file might be raw?
        # `load_register_overrides` presumably loads raw sentences.
        # But if we key by normalized, we might miss overrides if they are keyed by raw?
        # Or should we normalize overrides too?
        # Let's check overrides first with RAW sent, then NORMALIZED?
        # Safe bet: check RAW `sent` first (as it matches file input).
        
        if _WORKER_OVERRIDES and sent in _WORKER_OVERRIDES:
            r_enums = _WORKER_OVERRIDES[sent]
        else:
            r_enums = list(analyze_register(kotogram))
            
        # Calculate formality value
        # formality_to_weight returns (val, prag). If prag=0, use None (for SQL NULL)
        f_val, f_prag = formality_to_weight(f_enum)
        if f_prag == 0:
            f_val = None

        # Calculate gender value
        g_val, g_prag = infer_gender_from_register(g_enum, r_enums)
        
        r_ids = [REGISTER_LABEL_TO_ID[r] for r in r_enums if r in REGISTER_LABEL_TO_ID]
        if not r_ids:
             r_ids = [NEUTRAL_R_ID]
        
        # STRICT GRAMMATICALITY:
        # A sentence is grammatic (1) ONLY if:
        # 1. Source says it is grammatic (gram=1)
        # 2. Formality is pragmatic (f_prag=1)
        # 3. Gender is pragmatic (g_prag=1)
        # Otherwise, even if source says gram=1, we demote to 0.
        final_gram = gram and f_prag and g_prag

        # Store result with NORMALIZED sentence
        results.append((
            normalized_sent,
            f_val if f_prag else None,
            g_val if g_prag else None,
            final_gram,
            ",".join(map(str, sorted(r_ids)))
        ))
        
    return results








def print_record(sent: str, f_val: Any, g_val: Any, gram: int, r_ids_str: str, source: str):
    """Print a sentence record with a clear source indicator."""
    console.print(f"[bold yellow]Source: {source}[/bold yellow]")
    console.print(f"[bold]Sentence:[/bold] {sent}")
    console.print(f"[bold]Formality:[/bold] {f_val}")
    console.print(f"[bold]Gender:[/bold] {g_val}")
    console.print(f"[bold]Grammatic:[/bold] {gram}")
    
    # Decode register IDs back to labels
    if r_ids_str:
        r_ids = [int(x) for x in r_ids_str.split(",") if x]
        from kotogram.constants import REGISTER_ID_TO_LABEL
        r_labels = [REGISTER_ID_TO_LABEL[rid].name for rid in r_ids]
        console.print(f"[bold]Registers:[/bold] {', '.join(r_labels)}")
    else:
        console.print("[bold]Registers:[/bold] (None)")


def curate_show(sentence: str):
    """Show labels for a single sentence (Calculated)."""
    overrides = load_register_overrides()
    init_worker(overrides)
    
    # Analyze assuming source is grammatic (1) separately from DB
    results = analyze_chunk([(sentence, 1)])
    
    if not results:
        console.print("[red]Analysis failed.[/red]")
        return
        
    res = results[0]
    # res structure: (sent, f_val, g_val, gram, r_ids_str)
    print_record(res[0], res[1], res[2], res[3], res[4], "Calculated (Live)")


def curate_read(sentence: str, db_path: str):
    """Read labels for a single sentence from DB."""
    if not os.path.exists(db_path):
        console.print(f"[red]Database not found at {db_path}[/red]")
        return

    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    
    query = "SELECT formality, gender, grammatic, register_ids FROM corpus WHERE sentence = ?"
    c.execute(query, (sentence,))
    row = c.fetchone()
    conn.close()
    
    if row:
        # row: (formality, gender, grammatic, register_ids)
        print_record(sentence, row[0], row[1], row[2], row[3], f"corpus.db ({db_path})")
    else:
        console.print(f"[red]Sentence not found in {db_path}[/red]")



def curate_summary(db_path: str):
    """Print summary statistics from the database."""
    if not os.path.exists(db_path):
        console.print(f"[red]Database not found at {db_path}[/red]")
        return
        
    console.print(f"[bold blue]Reading from {db_path}...[/bold blue]")
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    
    # Initialize Counters
    from collections import Counter

    from rich.table import Table

    from kotogram.constants import REGISTER_ID_TO_LABEL
    
    label_stats = {
        "formality": Counter(),
        "gender_prag": Counter(),
        "register": Counter(),
        "grammatic": Counter(),
    }
    
    # Query all data
    # We could do aggregates in SQL but splitting register_ids is easier in Python.
    query = "SELECT formality, gender, grammatic, register_ids FROM corpus"
    c.execute(query)
    
    # Formality Weight map (approximate reverse mapping)
    # -1.0: Very Casual, -0.5: Casual, 0.0: Neutral, 0.5: Formal, 1.0: Very Formal
    # We need to map back to IDs to reuse label.py logic or just map to labels directly.
    # Let's map to labels directly for display.
    # We need to look up ID from weight? Or just hardcode the display labels.
    # label.py uses FORMALITY_ID_TO_LABEL[id].value
    # Let's map float -> Label Name
    
    # We can match FormalityLevel enum values?
    # FormalityLevel.VERY_CASUAL etc.
    # Actually, let's just use a simple map for the summary.
    w_to_label = {
        -1.0: "Very Casual",
        -0.5: "Casual",
        0.0: "Neutral",
        0.5: "Formal",
        1.0: "Very Formal"
    }

    for row in c:
        formality, gender, grammatic, r_ids_str = row
        
        # Formality
        if formality is not None:
            # Round to nearest 0.5 to be safe
            w = round(formality * 2) / 2
            lbl = w_to_label.get(w, f"Unknown ({w})")
            label_stats["formality"][lbl] += 1
        
        # Gender Prag
        g_prag = 1 if gender is not None else 0
        label_stats["gender_prag"][g_prag] += 1
        
        # Grammatic
        label_stats["grammatic"][grammatic] += 1
        
        # Registers
        if r_ids_str:
            for rid_str in r_ids_str.split(","):
                if rid_str:
                    rid = int(rid_str)
                    # Count ID
                    label_stats["register"][rid] += 1

    conn.close()

    # Print functions
    def _print_dist(title: str, style: str, counts: Counter, map_func=None):
        table = Table(title=title, show_header=True, header_style=style)
        table.add_column("Type", style="dim")
        table.add_column("Count", justify="right")
        table.add_column("Percentage", justify="right")
        total = sum(counts.values()) or 1
        for key in sorted(counts.keys()):
            label = map_func(key) if map_func else str(key)
            count = counts[key]
            table.add_row(str(label), f"{count:,}", f"{100 * count / total:.1f}%")
        console.print(table)
    
    # Print Tables
    _print_dist(
        "Formality Distribution",
        "bold magenta",
        label_stats["formality"]
    )
    
    _print_dist(
        "Gender Pragmatic Distribution",
        "bold cyan",
        label_stats["gender_prag"],
        lambda x: {1: "Pragmatic", 0: "Unpragmatic"}[x]
    )

    _print_dist(
        "Register Distribution",
        "bold yellow",
        label_stats["register"],
        lambda x: REGISTER_ID_TO_LABEL[x].value if x in REGISTER_ID_TO_LABEL else str(x)
    )

    _print_dist(
        "Grammaticality Distribution",
        "bold green",
        label_stats["grammatic"],
        lambda x: {1: "Grammatic", 0: "Agrammatic"}[x]
    )



    _print_dist(
        "Grammaticality Distribution",
        "bold green",
        label_stats["grammatic"],
        lambda x: {1: "Grammatic", 0: "Agrammatic"}[x]
    )


def curate_distinct(db_path: str, include_ungrammatic: bool):
    """Print counts of distinct style combinations."""
    if not os.path.exists(db_path):
        console.print(f"[red]Database not found at {db_path}[/red]")
        return
        
    console.print(f"[bold blue]Reading from {db_path}...[/bold blue]")
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    
    from collections import Counter

    from rich.table import Table

    from kotogram.constants import REGISTER_ID_TO_LABEL
    
    counts = Counter()
    
    w_to_label = {
        -1.0: "Very Casual",
        -0.5: "Casual",
        0.0: "Neutral",
        0.5: "Formal",
        1.0: "Very Formal"
    }

    query = "SELECT formality, gender, grammatic, register_ids FROM corpus"
    if not include_ungrammatic:
        query += " WHERE grammatic = 1"
        
    c.execute(query)
    
    for row in c:
        formality, gender, grammatic, r_ids_str = row
        
        parts = []
        
        # Formality
        if formality is not None:
            w = round(formality * 2) / 2
            f_lbl = w_to_label.get(w, f"Unknown ({w})")
            parts.append(f"Formality: {f_lbl}")
        else:
            parts.append("Formality: None")
            
        # Gender
        # Distinct report should probably show if it's Male/Female if pragmatic, or just Pragmatic?
        # User asked for "human-readable string of *all* the information".
        # "all the information in a row, except for Japanese"
        # The row has gender value (Real) or None. 
        # So we should probably report "Gender: Male", "Gender: Female", "Gender: Neutral" if possible?
        # Or just "Gender: Pragmatic" vs "Unpragmatic"? 
        # Given "information in a row", and previous commands show float value.
        # But for distinct combinations, rounding float gender is tricky. 
        # Usually gender is distinct values like -1, -0.5, 0, 0.5, 1? 
        # Wait, gender logic usually produces binary-ish weights or ranges?
        # Actually in `label.py` we just bin it to Pragmatic/Unpragmatic for summary.
        # But here let's try to be more descriptive if it's discrete.
        # If it's continuous, we can't key on it easily.
        # Let's check `gender_analysis` or just report "Gender: Pragmatic" / "Gender: Unpragmatic".
        # Or maybe "Gender: Male (1.0)", "Gender: Female (-1.0)".
        # Let's stick to "Gender: Pragmatic" vs "Unpragmatic" if it's continuous, OR buckets?
        # User said "all the information".
        # Let's try to map the float value if it's standard.
        if gender is not None:
             # g_lbl = f"Gender: {gender}" # Too granular?
             # Let's bucketize for readability?
             # "Male", "Female", "Neutral"?
             # Let's say "Pragmatic (val)" or just "Pragmatic". 
             # Let's default to "Gender: Pragmatic" vs "Gender: Unpragmatic" used in Label summary.
             # Actually, simpler: "Gender: Pragmatic/Unpragmatic" is safer for aggregation.
             # But if user wants specific distinct rows, maybe they care about specific weights?
             # Let's check typical values. They are usually derived from weights.
             # Let's use "Gender: {val}" but rounded?
             # Let's assume for now "Gender: {val}" if pragmatic.
             parts.append(f"Gender: {gender}")
        else:
             parts.append("Gender: Unpragmatic") # Or None
             
        # Grammatic
        parts.append(f"Grammatic: {grammatic}")
        
        # Registers
        r_labels = []
        if r_ids_str:
            for rid_str in r_ids_str.split(","):
                if rid_str:
                    rid = int(rid_str)
                    if rid in REGISTER_ID_TO_LABEL:
                        r_labels.append(REGISTER_ID_TO_LABEL[rid].name)
                    else:
                        r_labels.append(str(rid))
        parts.append(f"Registers: {', '.join(sorted(r_labels)) if r_labels else '(None)'}")
        
        key = ", ".join(parts)
        counts[key] += 1
        
    conn.close()
    
    table = Table(title="Distinct Style Combinations", show_header=True)
    table.add_column("Count", justify="right")
    table.add_column("Percentage", justify="right")
    table.add_column("Style Combination", justify="left")
    
    total = sum(counts.values()) or 1
    
    for key, count in counts.most_common():
        pct = f"{100 * count / total:.1f}%"
        table.add_row(f"{count:,}", pct, key)
        
    console.print(table)



    console.print(table)


def ensure_kc_index(corpus_db: str, index_db: str):
    """Ensure the KC index exists, building it if necessary."""
    if os.path.exists(index_db):
        return

    console.print(f"[bold yellow]Building KC Index at {index_db}...[/bold yellow]")
    
    # 1. Load Sentences
    if not os.path.exists(corpus_db):
        console.print(f"[red]Corpus DB not found at {corpus_db}[/red]")
        sys.exit(1)
        
    conn = sqlite3.connect(corpus_db)
    c = conn.cursor()
    c.execute("SELECT sentence FROM corpus WHERE grammatic = 1")
    rows = c.fetchall()
    conn.close()
    
    sentences = [r[0] for r in rows]
    console.print(f"Loaded {len(sentences)} grammatic sentences.")
    
    # 2. Parallel Tokenization
    # We use the same pool logic as curate_drink broadly
    num_processes = max(1, mp.cpu_count() - 1)
    chunk_size = 1000
    chunks = [sentences[i : i + chunk_size] for i in range(0, len(sentences), chunk_size)]
    
    manager = mp.Manager()
    result_queue = manager.Queue()
    pool = mp.Pool(num_processes)
    
    jobs = []
    for i, chunk in enumerate(chunks):
        job = pool.apply_async(worker_tokenize_wrapper, (i, chunk, result_queue))
        jobs.append(job)
        
    pool.close()
    
    # Collect results
    all_kotograms = [] # List of (sent, kotogram)
    
    from rich.progress import track
    # Monitor progress
    with Progress() as progress:
        task_id = progress.add_task("Tokenizing...", total=len(jobs))
        
        finished_jobs = 0
        while finished_jobs < len(jobs):
            try:
                # Non-blocking check?
                # Actually queue.get is blocking.
                # We expect one result per job.
                chunk_res = result_queue.get(timeout=1.0)
                all_kotograms.extend(chunk_res)
                finished_jobs += 1
                progress.advance(task_id)
            except queue.Empty:
                pass
                
    pool.join()
    
    # Sort by original Sentence to be deterministic?
    # The queue might return out of order.
    # It doesn't strictly matter for the index, but let's keep it stable.
    # We stored (sent, kotogram).
    
    # 3. Batch Inference (KC Extraction)
    from kotogram.analysis import grammars
    
    batch_size = 256
    
    # Prepare DB
    idx_conn = sqlite3.connect(index_db)
    idx_c = idx_conn.cursor()
    idx_c.execute("CREATE TABLE IF NOT EXISTS sentences (id INTEGER PRIMARY KEY, text TEXT, length INTEGER)")
    idx_c.execute("CREATE TABLE IF NOT EXISTS kcs (kc_id INTEGER, sentence_id INTEGER)")
    idx_c.execute("CREATE INDEX IF NOT EXISTS idx_kcs_kc_id ON kcs (kc_id)")
    idx_c.execute("CREATE INDEX IF NOT EXISTS idx_kcs_sentence_id ON kcs (sentence_id)")
    idx_c.execute("CREATE INDEX IF NOT EXISTS idx_sentences_length ON sentences (length)")
    
    # We will insert sentences as we go? Or bulk at end?
    # Bulk is faster.
    
    sent_buffer = [] # (id, text, len)
    kc_buffer = []   # (kc_id, sent_id)
    
    current_sent_id = 0
    
    # Unzip
    sent_list = [x[0] for x in all_kotograms]
    koto_list = [x[1] for x in all_kotograms]
    
    total_batches = (len(koto_list) + batch_size - 1) // batch_size
    
    for i in track(range(0, len(koto_list), batch_size), description="Extracting KCs..."):
        batch_koto = koto_list[i : i + batch_size]
        batch_sent = sent_list[i : i + batch_size]
        
        # Run model
        results = grammars(batch_koto)
        
        for sent, res in zip(batch_sent, results):
            current_sent_id += 1
            sent_buffer.append((current_sent_id, sent, len(sent)))
            
            if res.kc_top:
                for kc_id in res.kc_top:
                    kc_buffer.append((kc_id, current_sent_id))
                    
    # Bulk Insert
    console.print("Indexing...")
    idx_c.executemany("INSERT INTO sentences (id, text, length) VALUES (?, ?, ?)", sent_buffer)
    idx_c.executemany("INSERT INTO kcs (kc_id, sentence_id) VALUES (?, ?)", kc_buffer)
    idx_conn.commit()
    idx_conn.close()
    console.print(f"[green]Index built with {len(sent_buffer)} sentences.[/green]")


def curate_find_kc_matches(query: str, db_path: str, index_path: str = "data/corpus-kc-index.db"):
    """Find shortest sentences matching the KC query."""
    # Parse Query
    # Format: +458,-964
    parts = [p.strip() for p in query.split(",")]
    required_kcs = []
    forbidden_kcs = []
    
    for p in parts:
        if not p: continue
        if p.startswith("+"):
            val_str = p[1:]
            if not val_str.isdigit():
                console.print(f"[red]Invalid KC ID: {p}[/red]")
                return
            required_kcs.append(int(val_str))
        elif p.startswith("-"):
            val_str = p[1:]
            if not val_str.isdigit():
                console.print(f"[red]Invalid KC ID: {p}[/red]")
                return
            forbidden_kcs.append(int(val_str))
        else:
            # Assume + if no sign?
            if not p.isdigit():
                console.print(f"[red]Invalid KC format: {p}[/red]")
                return
            required_kcs.append(int(p))
                
    ensure_kc_index(db_path, index_path)
    
    conn = sqlite3.connect(index_path)
    c = conn.cursor()
    
    # Construct Query
    # Base
    sql = "SELECT s.id, s.text, s.length FROM sentences s"
    params = []
    
    # Joins for Required
    for i, kc in enumerate(required_kcs):
        alias = f"k{i}"
        sql += f" JOIN kcs {alias} ON s.id = {alias}.sentence_id AND {alias}.kc_id = ?"
        params.append(kc)
        
    # Validations
    wheres = []
    
    # Forbidden
    if forbidden_kcs:
        placeholders = ",".join("?" * len(forbidden_kcs))
        wheres.append(f"NOT EXISTS (SELECT 1 FROM kcs kn WHERE s.id = kn.sentence_id AND kn.kc_id IN ({placeholders}))")
        params.extend(forbidden_kcs)
        
    if wheres:
        sql += " WHERE " + " AND ".join(wheres)
        
    # LIMIT 20000 to find strictly increasing lengths
    sql += " ORDER BY s.length ASC LIMIT 20000"
    
    # console.print(f"[dim]SQL: {sql} | Params: {params}[/dim]")
    
    c.execute(sql, params)
    rows = c.fetchall()
    conn.close()
    
    # Filter for increasing lengths
    final_rows = []
    current_max_len = 4 # Start looking for length > 4 (i.e. 5)
    for r in rows:
        length = r[2] # Index 2 is length now (id, text, length)
        if length > current_max_len:
            final_rows.append(r)
            current_max_len = length
            if len(final_rows) >= 10:
                break
    
    # Display
    from rich.table import Table
    from collections import Counter
    from kotogram.analysis import grammars
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser, KotogramFormat
    
    if not final_rows:
         table = Table(title=f"Matches for {query} (Increasing Length)")
         table.add_column("Sentence", style="blue")
         table.add_column("Length", justify="right")
         table.add_row("(No matches found)", "")
         console.print(table)
         return

    # Fetch KCs via Inference (for weights)
    # final_rows is list of (id, text, length)
    texts = [r[1] for r in final_rows]
    found_ids = [r[0] for r in final_rows]
    
    # Tokenize
    parser = SudachiJapaneseParser()
    kotograms = [parser.japanese_to_kotogram(t, KotogramFormat.TRAINING_MASK) for t in texts]
    
    # Inference
    results = grammars(kotograms)
    
    # Organize Weights: sid -> {kcid: weight}
    sent_weights = {}
    all_found_kcs = []
    
    for r, res in zip(final_rows, results):
        sid = r[0]
        # res.kc_top is Dict[int, float]
        weights = res.kc_top if res.kc_top else {}
        sent_weights[sid] = weights
        all_found_kcs.extend(weights.keys())

    # Determine columns
    # 1. Query KCs first
    # 2. Round-Robin Lowest-Frequency Selection
    
    target_kcs = []
    target_kcs.extend(sorted(list(required_kcs)))
    target_kcs.extend(sorted(list(forbidden_kcs)))
    
    target_kc_set = set(target_kcs)
    
    # Global counts for uniqueness selection
    counts = Counter(all_found_kcs)
    
    # Pre-calculate candidates for each sentence, sorted by rarity (asc freq)
    sent_candidates = {}
    for sid in found_ids:
        weights = sent_weights.get(sid, {})
        # Sort by frequency asc
        candidates = sorted([(k, counts[k]) for k in weights.keys()], key=lambda x: x[1])
        sent_candidates[sid] = [k for k, _ in candidates]
        
    # Round Robin to fill up to 24 columns
    while len(target_kcs) < 24:
        added_any = False
        for sid in found_ids:
            if len(target_kcs) >= 24:
                break
                
            candidates = sent_candidates[sid]
            # Find first candidate not in target_kcs
            found_k = None
            for k in candidates:
                if k not in target_kc_set:
                    found_k = k
                    break
            
            if found_k is not None:
                target_kcs.append(found_k)
                target_kc_set.add(found_k)
                added_any = True
                
        if not added_any:
            break
            
    # Sort the grid KCs by Average Weight Descending (excluding Query KCs? Or all?)
    # "Sort the columns by average weight descending".
    # Query KCs should probably stay on left as anchor. Let's keep them separate.
    # Actually user said "the columns", implies all.
    # BUT keeping query on left is good for context.
    # Let's keep Query KCs first, then sort the Discriminative ones.
    
    # Identify Discriminative vs Query
    query_kc_set = set(required_kcs) | set(forbidden_kcs)
    
    discriminative_kcs = [k for k in target_kcs if k not in query_kc_set]
    
    # Calculate Avg Weight for Discriminative
    def get_avg_weight(k):
        total_w = 0
        count = 0
        for sid in found_ids:
            weights = sent_weights.get(sid, {})
            if k in weights:
                total_w += weights[k]
                count += 1 # Or divide by total rows? Avg over all rows or just present?
                # "Average weight" usually implies over the dataset.
        return total_w / len(final_rows)
        
    discriminative_kcs.sort(key=get_avg_weight, reverse=True)
    
    # Reassemble Target: Query + Sorted Discriminative
    # Wait, we need to respect the original target_kcs list which has Query first?
    # Yes, target_kcs was built as [Query...] + [RoundRobin...].
    # But RoundRobin order was arbitrary (uniqueness). Sorting by weight improves it.
    
    # Re-build target_kcs
    # 1. Query KCs (Sorted)
    sorted_query = sorted(list(query_kc_set))
    # 2. Discriminative (Sorted by Weight)
    final_target = []
    # Add Query KCs present in target_kcs (to respect any filtering)
    # Actually all query KCs were added.
    final_target.extend(sorted_query) 
    final_target.extend(discriminative_kcs)
    
    # Footer Optimization: Separate uniform columns
    grid_kcs = []
    common_kcs = []
    absent_kcs = []
    
    for kc in final_target:
        # Check presence in all rows
        present_count = 0
        for sid in found_ids:
            weights = sent_weights.get(sid, {})
            if kc in weights and weights[kc] > 0:
                present_count += 1
                
        if present_count == len(final_rows):
            common_kcs.append(kc)
        elif present_count == 0:
            absent_kcs.append(kc)
        else:
            grid_kcs.append(kc)
            
    # Calculate Column Means (On vs Off) for Footer
    kc_stats = {}
    for kc in grid_kcs:
        on_weights = []
        off_weights = []
        for sid in found_ids:
            weights = sent_weights.get(sid, {})
            if kc in weights:
                on_weights.append(weights[kc])
            else:
                off_weights.append(0.0)
                
        mean_on = sum(on_weights) / len(on_weights) if on_weights else 0.0
        mean_off = sum(off_weights) / len(off_weights) if off_weights else 0.0
        kc_stats[kc] = (mean_on, mean_off)

    # Format Helper
    def fmt_w(val):
        s = f"{val:.2f}"
        if s.startswith("0."):
            return s[1:] # .95
        if s == "0.00":
            return ".00"
        return s

    # Create Table
    # Optimized for horizontal density: No "Len" column, compact KC headers, minimal padding
    # show_footer=True is default if footers are present
    table = Table(title=f"Matches for {query} (Increasing Length) - KC Indicators", box=None, padding=(0, 1), collapse_padding=True, show_footer=True)
    
    table.add_column("Sentence", style="blue", footer="Mean +\nMean -")
    # table.add_column("Len", justify="right") # Removed per request
    
    for kc in grid_kcs:
        m_on, m_off = kc_stats[kc]
        footer_txt = f"{fmt_w(m_on)}\n{fmt_w(m_off)}"
        table.add_column(str(kc), justify="center", footer=footer_txt)
        
    for r in final_rows:
        sid, text, length = r
        row_cells = [text]
        
        weights = sent_weights.get(sid, {})
        
        for kc in grid_kcs:
            if kc in weights and weights[kc] > 0:
                # Revert to checkmark
                row_cells.append("[bold green]✔[/bold green]")
            else:
                row_cells.append("[grey70]-[/grey70]")
                
        table.add_row(*row_cells)
        
    # Use a wide console to prevent truncation
    wide_console = Console(width=2000)
    wide_console.print(table)

    # Print Footers (Common/Absent only)
    if common_kcs:
        console.print(f"[bold green]Common (+):[/bold green] {', '.join(map(str, common_kcs))}")
    if absent_kcs:
        console.print(f"[grey70]Absent (-): {', '.join(map(str, absent_kcs))}[/grey70]")



def curate_kc_families(sentence: str):
    """
    Show KC target families for a single Japanese sentence.
    
    This helps visualize what the KCTrainer sees during training for each
    morphological family (bags, tails, ngrams, tail-ngrams).
    """
    from rich.table import Table
    
    from kotogram.japanese_parser import KotogramFormat
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
    from kotogram.tokenizer import CLS_ID, Tokenizer
    from train.kc import (
        ALL_KC_FAMILIES,
        FAMILY_FEATURES,
        KC_NGRAM_ORDER,
        KC_POS_BIASED_WINDOW,
        compute_kc_targets,
        get_family,
        get_family_bucket_size,
        initialize_disallow_filter,
        is_family_sparse,
        stable_hash_ints,
    )

    # Parse sentence
    parser = SudachiJapaneseParser()
    kotogram = parser.japanese_to_kotogram(sentence, KotogramFormat.TRAINING_MASK)

    # Tokenize
    # We need a tokenizer to get feature IDs. Use default vocab if exists.
    from train import paths
    import os

    vocab_path = os.path.join(paths.get_style_dataset_cache_dir(), "vocab.json")
    if not os.path.exists(vocab_path):
        console.print(f"[red]Vocab not found at {vocab_path}. Run 'bin/train_style --label' first.[/red]")
        return

    tokenizer = Tokenizer.load(vocab_path)

    # Initialize disallow filter (matches production code in dataset.py and label.py)
    compound_1_vocab = tokenizer.field_vocabs.get("compound_1", {})
    initialize_disallow_filter(compound_1_vocab)

    # Encode the kotogram to get feature IDs
    encoded = tokenizer.encode(kotogram)

    # Compute KC targets
    targets = compute_kc_targets(encoded)
    
    # Display header
    console.print(f"\n[bold blue]KC Families for:[/bold blue] {sentence}")
    console.print(f"[dim]Kotogram:[/dim] {kotogram}")
    console.print(f"[dim]Length:[/dim] {len(encoded.get('pos', []))} tokens")
    console.print()
    
    # Group families using is_family_* helpers
    from train.kc import get_family, is_family_sparse, is_family_db_sourced
    bag_families = [f for f in ALL_KC_FAMILIES if not is_family_sparse(f) and not is_family_db_sourced(f) and not get_family(f).is_tail]
    tail_families = [f for f in ALL_KC_FAMILIES if not is_family_sparse(f) and not is_family_db_sourced(f) and get_family(f).is_tail]
    ngram_families = [f for f in ALL_KC_FAMILIES if is_family_sparse(f) and not get_family(f).is_tail]
    tail_ngram_families = [f for f in ALL_KC_FAMILIES if is_family_sparse(f) and get_family(f).is_tail]
    db_families = [f for f in ALL_KC_FAMILIES if is_family_db_sourced(f)]

    # Build reverse lookup for all fields
    id_to_token_map = {}
    for field in ["pos", "compound_1", "compound_2", "conjugated_type", "reading_gram"]:
        field_vocab = tokenizer.field_vocabs.get(field, {})
        id_to_token_map[field] = {v: k for k, v in field_vocab.items()}
    
    def _decode_id(val: int, family) -> str:
        """Decode an ID using direct field vocabulary lookup."""
        field = FAMILY_FEATURES.get(family, "")
        id_map = id_to_token_map.get(field, {})
        return id_map.get(val, f"#{val}")

    def _compute_ngram_details(family, is_tail: bool):
        """Compute ngrams with their source tokens and hash values.
        
        IMPORTANT: This must mirror the logic in train/kc.py to show accurate data.
        For tail ngrams, we must filter by position using disallowed_positions.
        """
        from kotogram.tokenizer import UNK_ID
        from train.kc import KcFamilyId, _get_hierarchical_ids, get_disallowed_positions, SPECIAL_TOKEN_IDS

        field = FAMILY_FEATURES.get(family, "")
        if field not in encoded:
            return []

        # Get raw IDs
        raw_ids = _get_hierarchical_ids(encoded, family)
        seq_len = len(raw_ids)

        if is_tail:
            # For tail ngrams, use position-aware filtering (matches _compute_tail_ngram_targets)
            disallowed_positions = get_disallowed_positions(encoded)
            tail_start = max(0, seq_len - KC_POS_BIASED_WINDOW)

            # Filter by position: skip disallowed positions and special tokens
            ids = []
            for i in range(tail_start, seq_len):
                if i in disallowed_positions:
                    continue
                if raw_ids[i] in SPECIAL_TOKEN_IDS:
                    continue
                ids.append(raw_ids[i])

            # Filter UNK if family has filter_unk=True
            if get_family(family).filter_unk:
                ids = [v for v in ids if v != UNK_ID]
        else:
            # For non-tail ngrams, just filter CLS (matches _compute_ngram_targets)
            disallowed_positions = get_disallowed_positions(encoded)
            ids = []
            for i, v in enumerate(raw_ids):
                if i in disallowed_positions:
                    continue
                if v == CLS_ID:
                    continue
                ids.append(v)

            # Filter UNK if family has filter_unk=True
            if get_family(family).filter_unk:
                ids = [v for v in ids if v != UNK_ID]

        if not ids:
            return []

        salt = get_family(family).salt or 0
        bucket_size = get_family_bucket_size(family)

        ngram_details = []
        for n_val in range(2, KC_NGRAM_ORDER + 1):
            if len(ids) >= n_val:
                for i in range(len(ids) - n_val + 1):
                    ngram_ids = ids[i : i + n_val]
                    h = stable_hash_ints([salt, *ngram_ids]) % bucket_size
                    # Decode using vocabulary lookup (now contains composite tokens)
                    tokens = [_decode_id(v, family) for v in ngram_ids]
                    ngram_details.append((h, tokens))

        return ngram_details
    
    def _print_family_group(title: str, families: list, color: str, show_ngram_content: bool = False):
        table = Table(title=title, show_header=True, header_style=f"bold {color}")
        table.add_column("Family", style="cyan", min_width=25)
        table.add_column("Field", style="dim", min_width=15)
        table.add_column("Type", justify="center", min_width=8)
        table.add_column("Count", justify="right", min_width=6)
        table.add_column("Values", style="green", min_width=40)
        
        for family in families:
            field = FAMILY_FEATURES.get(family, "?")
            is_sparse = is_family_sparse(family)
            is_db = is_family_db_sourced(family)
            if is_db:
                type_str = "[red]db[/red]"
            elif is_sparse:
                type_str = "[yellow]sparse[/yellow]"
            else:
                type_str = "[green]dense[/green]"
            
            vals = targets.get(family, [])
            count = len(vals) if isinstance(vals, list) else 0
            
            # Format values
            if is_db:
                val_str = "(DB-sourced - not computed from tokens)"
            elif is_sparse and show_ngram_content:
                # Compute and show ngrams with content
                is_tail = get_family(family).is_tail
                ngram_details = _compute_ngram_details(family, is_tail)
                if ngram_details:
                    # Format: hash→[tokens]
                    parts = [f"{h}→{'|'.join(toks)}" for h, toks in ngram_details]
                    if len(parts) > 8:
                        val_str = ", ".join(parts[:8]) + f"... ({len(parts)} total)"
                    else:
                        val_str = ", ".join(parts)
                else:
                    val_str = "(empty)"
            elif is_sparse:
                # Show hash bucket IDs (cap at 10 for readability)
                if len(vals) > 10:
                    bucket_size = get_family_bucket_size(family)
                    val_str = f"{vals[:10]}... ({len(vals)} total, mod {bucket_size})"
                else:
                    val_str = str(vals) if vals else "(empty)"
            else:
                # Dense: Show actual vocab IDs with single-field decode
                # (Dense families use original field IDs, not composite hashes)
                if count == 0:
                    val_str = "(empty)"
                elif count <= 10:
                    decoded = []
                    field = FAMILY_FEATURES.get(family, "")
                    id_to_token = id_to_token_map.get(field, {})
                    for v in vals:
                        token = id_to_token.get(v, f"#{v}")
                        decoded.append(f"{v}:{token}")
                    val_str = ", ".join(decoded)
                else:
                    val_str = f"{vals[:10]}... ({len(vals)} total)"
            
            table.add_row(
                family.name,
                field,
                type_str,
                str(count),
                val_str,
            )
        
        console.print(table)
        console.print()
    
    # Print each group
    _print_family_group("Bag Families (Full Sentence)", bag_families, "magenta")
    _print_family_group(f"Tail Families (Last {KC_POS_BIASED_WINDOW} Tokens)", tail_families, "cyan")
    _print_family_group("N-gram Families (2-3 grams, hashed)", ngram_families, "yellow", show_ngram_content=True)
    _print_family_group(f"Tail N-gram Families (Last {KC_POS_BIASED_WINDOW} Tokens, hashed)", tail_ngram_families, "blue", show_ngram_content=True)
    if db_families:
        _print_family_group("DB-Sourced Families", db_families, "red")
    
    # Summary stats
    total_dense = sum(len(targets.get(f, [])) for f in bag_families + tail_families)
    total_sparse = sum(len(targets.get(f, [])) for f in ngram_families + tail_ngram_families)
    
    console.print(f"[bold]Summary:[/bold] {total_dense} dense targets, {total_sparse} sparse targets, {len(db_families)} DB-sourced families")


# Globals for worker initialization
_KC_LINT_PARSER: Any = None
_KC_LINT_TOKENIZER: Any = None


def _init_kc_lint_worker(tokenizer_path: str):
    """Initialize KC lint worker with parser and tokenizer."""
    global _KC_LINT_PARSER, _KC_LINT_TOKENIZER
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
    from kotogram.tokenizer import Tokenizer
    _KC_LINT_PARSER = SudachiJapaneseParser()
    _KC_LINT_TOKENIZER = Tokenizer.load(tokenizer_path)


def _check_sentence_for_unk(sentence: str):
    """Check a single sentence for UNK in reading_gram. Returns tuple if found, else None."""
    from kotogram.japanese_parser import KotogramFormat
    from kotogram.kotogram import extract_token_features, split_kotogram
    from kotogram.tokenizer import UNK_ID
    from train.kc import KcFamilyId, compute_kc_targets

    kotogram = _KC_LINT_PARSER.japanese_to_kotogram(sentence, KotogramFormat.TRAINING_MASK)
    encoded = _KC_LINT_TOKENIZER.encode(kotogram)
    targets = compute_kc_targets(encoded)

    reading_gram_targets = targets.get(KcFamilyId.BAG_READING_GRAM, [])
    if UNK_ID in reading_gram_targets:
        tokens = split_kotogram(kotogram)
        for token in tokens:
            features = extract_token_features(token)
            rg = features.reading_gram
            rg_id = _KC_LINT_TOKENIZER.get_id("reading_gram", rg)
            # Skip punctuation - we want non-punctuation UNK cases
            if rg_id == UNK_ID and features.pos != "aux-symbol":
                return ("unk", sentence, features.surface, features.pos, rg)
    return None


def _check_sentence_for_pad(sentence: str):
    """Check a single sentence for PAD in reading_gram. Returns tuple if found, else None."""
    from kotogram.japanese_parser import KotogramFormat
    from kotogram.kotogram import extract_token_features, split_kotogram
    from kotogram.tokenizer import PAD_ID
    from train.kc import KcFamilyId, compute_kc_targets

    kotogram = _KC_LINT_PARSER.japanese_to_kotogram(sentence, KotogramFormat.TRAINING_MASK)
    encoded = _KC_LINT_TOKENIZER.encode(kotogram)
    targets = compute_kc_targets(encoded)

    reading_gram_targets = targets.get(KcFamilyId.BAG_READING_GRAM, [])
    if PAD_ID in reading_gram_targets:
        tokens = split_kotogram(kotogram)
        for token in tokens:
            features = extract_token_features(token)
            rg = features.reading_gram
            rg_id = _KC_LINT_TOKENIZER.get_id("reading_gram", rg)
            if rg_id == PAD_ID:
                return ("pad", sentence, features.surface, features.pos, rg)
    return None


def _check_sentence_lint(sentence: str):
    """Check a sentence for all lint issues. Returns first issue found or None."""
    result = _check_sentence_for_unk(sentence)
    if result:
        return result
    result = _check_sentence_for_pad(sentence)
    if result:
        return result
    return None


def curate_kc_lint(db_path: str):
    """
    Scan corpus.db for KC lint issues.

    Checks for sentences with UNK or PAD in BAG_READING_GRAM.
    """
    import os

    from train import paths

    # Find tokenizer
    vocab_path = os.path.join(paths.get_style_dataset_cache_dir(), "vocab.json")
    if not os.path.exists(vocab_path):
        console.print(f"[red]Vocab not found at {vocab_path}. Run 'bin/train_style --label' first.[/red]")
        return

    # Load sentences from corpus
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    cursor.execute("SELECT sentence FROM corpus")
    sentences = [row[0] for row in cursor.fetchall()]
    conn.close()

    console.print(f"[bold]KC Lint:[/bold] Scanning {len(sentences):,} sentences...")

    # Run parallel scan
    num_workers = mp.cpu_count()
    unk_examples: List[Tuple[str, str, str, str, str]] = []
    pad_examples: List[Tuple[str, str, str, str, str]] = []
    unk_count = 0
    pad_count = 0

    with mp.Pool(
        num_workers,
        initializer=_init_kc_lint_worker,
        initargs=(vocab_path,),
    ) as pool:
        with create_progress(console) as progress:
            task = progress.add_task("Checking sentences...", total=len(sentences))

            for result in pool.imap_unordered(_check_sentence_lint, sentences, chunksize=500):
                progress.advance(task)
                if result:
                    issue_type = result[0]
                    if issue_type == "unk":
                        unk_count += 1
                        if len(unk_examples) < 5:
                            unk_examples.append(result)
                    elif issue_type == "pad":
                        pad_count += 1
                        if len(pad_examples) < 5:
                            pad_examples.append(result)

    # Report results
    console.print()
    console.print("[bold]Results:[/bold]")

    # UNK in reading_gram
    if unk_count == 0:
        console.print("  [green]✓[/green] No UNK in BAG_READING_GRAM (non-punctuation)")
    else:
        console.print(f"  [yellow]![/yellow] {unk_count:,} sentences with UNK in BAG_READING_GRAM")
        for _, sent, surface, pos, rg in unk_examples:
            truncated = sent[:60] + "..." if len(sent) > 60 else sent
            console.print(f"      [dim]{surface}[/dim] ({pos}) → {repr(rg)}")
            console.print(f"        {truncated}")

    # PAD in reading_gram
    if pad_count == 0:
        console.print("  [green]✓[/green] No PAD in BAG_READING_GRAM")
    else:
        console.print(f"  [yellow]![/yellow] {pad_count:,} sentences with PAD in BAG_READING_GRAM")
        for _, sent, surface, pos, rg in pad_examples:
            truncated = sent[:60] + "..." if len(sent) > 60 else sent
            console.print(f"      [dim]{surface}[/dim] ({pos}) → {repr(rg)}")
            console.print(f"        {truncated}")


# ============================================================================
# KC Hash Analysis
# ============================================================================

_KC_HASH_PARSER = None
_KC_HASH_TOKENIZER = None


def _init_kc_hash_worker(vocab_path: str):
    """Initialize worker for KC hash analysis."""
    global _KC_HASH_PARSER, _KC_HASH_TOKENIZER
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
    from kotogram.tokenizer import Tokenizer

    _KC_HASH_PARSER = SudachiJapaneseParser()
    _KC_HASH_TOKENIZER = Tokenizer.load(vocab_path)


def _compute_sentence_hashes(sentence: str) -> Dict[str, List[Tuple[Tuple[int, ...], int]]]:
    """
    Compute ngrams and their hashes for a sentence.
    Returns dict: family_name -> list of (ngram_tuple, hash_value).
    """
    from kotogram.japanese_parser import KotogramFormat
    from train.kc import (
        KC_NGRAM_ORDER,
        FAMILY_FEATURES,
        KcFamilyId,
        SPECIAL_TOKEN_IDS,
        _salt,
        get_family_bucket_size,
        stable_hash_ints,
    )

    kotogram = _KC_HASH_PARSER.japanese_to_kotogram(sentence, KotogramFormat.TRAINING_MASK)
    encoded = _KC_HASH_TOKENIZER.encode(kotogram)

    result: Dict[str, List[Tuple[Tuple[int, ...], int]]] = {}

    # Regular ngram families (sparse, non-tail)
    from train.kc import ALL_KC_FAMILIES, is_family_sparse, get_family
    ngram_families = [
        fid for fid in ALL_KC_FAMILIES
        if is_family_sparse(fid) and not get_family(fid).is_tail
    ]

    for family_id in ngram_families:
        field = FAMILY_FEATURES[family_id]
        if field in encoded:
            ids = [v for v in encoded[field] if v not in SPECIAL_TOKEN_IDS]
            salt = _salt(family_id)
            family_hashes = []
            bucket_size = get_family_bucket_size(family_id)
            for n_val in range(2, KC_NGRAM_ORDER + 1):
                if len(ids) >= n_val:
                    for i in range(len(ids) - n_val + 1):
                        ngram = tuple(ids[i : i + n_val])
                        h = stable_hash_ints([salt, *ngram]) % bucket_size
                        family_hashes.append((ngram, h))
            if family_hashes:
                result[family_id.name] = family_hashes

    # Tail ngram families (sparse, tail)
    tail_ngram_families = [
        fid for fid in ALL_KC_FAMILIES
        if is_family_sparse(fid) and get_family(fid).is_tail
    ]

    from train.kc import KC_POS_BIASED_WINDOW

    for family_id in tail_ngram_families:
        field = FAMILY_FEATURES[family_id]
        if field in encoded:
            ids = encoded[field]
            tail_ids = ids[-KC_POS_BIASED_WINDOW:] if len(ids) > 0 else []
            tail_ids = [v for v in tail_ids if v not in SPECIAL_TOKEN_IDS]
            if not tail_ids:
                continue
            salt = _salt(family_id)
            family_hashes = []
            bucket_size = get_family_bucket_size(family_id)
            for n_val in range(2, KC_NGRAM_ORDER + 1):
                if len(tail_ids) >= n_val:
                    for i in range(len(tail_ids) - n_val + 1):
                        ngram = tuple(tail_ids[i : i + n_val])
                        h = stable_hash_ints([salt, *ngram]) % bucket_size
                        family_hashes.append((ngram, h))
            if family_hashes:
                result[family_id.name] = family_hashes

    return result


def curate_kc_hash(db_path: str):
    """
    Analyze hash collision frequency for sparse KC families.

    Reports collision rates and bucket utilization per ngram family,
    and suggests minimum safe bucket sizes.
    """
    import os
    from collections import defaultdict

    from rich.table import Table

    from train import paths
    from train.kc import KcFamilyId, get_family_bucket_size

    # Find tokenizer
    vocab_path = os.path.join(paths.get_style_dataset_cache_dir(), "vocab.json")
    if not os.path.exists(vocab_path):
        console.print(f"[red]Vocab not found at {vocab_path}. Run 'bin/train_style --label' first.[/red]")
        return

    # Load grammatical sentences from corpus
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    cursor.execute("SELECT sentence FROM corpus WHERE grammatic = 1")
    sentences = [row[0] for row in cursor.fetchall()]
    conn.close()

    console.print(f"[bold]KC Hash Analysis:[/bold] Scanning {len(sentences):,} grammatical sentences...")

    # Aggregate: family -> hash -> set of unique ngrams
    family_hash_to_ngrams: Dict[str, Dict[int, set]] = defaultdict(lambda: defaultdict(set))

    # Run parallel scan
    num_workers = mp.cpu_count()

    with mp.Pool(
        num_workers,
        initializer=_init_kc_hash_worker,
        initargs=(vocab_path,),
    ) as pool:
        with create_progress(console) as progress:
            task = progress.add_task("Computing hashes...", total=len(sentences))

            for sent_result in pool.imap_unordered(_compute_sentence_hashes, sentences, chunksize=500):
                progress.advance(task)
                for family_name, ngram_hash_list in sent_result.items():
                    for ngram, h in ngram_hash_list:
                        family_hash_to_ngrams[family_name][h].add(ngram)

    # Compute statistics
    console.print()
    table = Table(title="KC Hash Collision Analysis", show_header=True, header_style="bold cyan")
    table.add_column("Family", style="dim")
    table.add_column("Ngrams", justify="right")
    table.add_column("BktSz", justify="right")
    table.add_column("Used", justify="right")
    table.add_column("Coll", justify="right")
    table.add_column("Exp", justify="right")
    table.add_column("Rate", justify="right")
    table.add_column("Max", justify="right")

    for family_name in sorted(family_hash_to_ngrams.keys()):
        hash_to_ngrams = family_hash_to_ngrams[family_name]

        # Get per-family bucket size
        family_id = KcFamilyId[family_name]
        bucket_count = get_family_bucket_size(family_id)

        # Count stats
        used_buckets = len(hash_to_ngrams)
        total_ngrams = sum(len(ngrams) for ngrams in hash_to_ngrams.values())
        collisions = sum(len(ngrams) - 1 for ngrams in hash_to_ngrams.values() if len(ngrams) > 1)
        max_bucket = max(len(ngrams) for ngrams in hash_to_ngrams.values()) if hash_to_ngrams else 0

        collision_rate = collisions / total_ngrams if total_ngrams > 0 else 0.0

        # Expected collisions:
        # - When n > B: pigeonhole principle (n - B)
        # - When n <= B: birthday paradox (n²/2B)
        if total_ngrams > bucket_count:
            expected_collisions = total_ngrams - bucket_count
        else:
            expected_collisions = (total_ngrams * total_ngrams) / (2 * bucket_count)

        rate_color = "green" if collision_rate < 0.01 else "yellow" if collision_rate < 0.05 else "red"

        table.add_row(
            family_name,
            f"{total_ngrams:,}",
            f"{bucket_count:,}",
            f"{used_buckets:,}",
            f"{collisions:,}",
            f"{expected_collisions:,.0f}",
            f"[{rate_color}]{collision_rate:.2%}[/{rate_color}]",
            f"{max_bucket:,}",
        )

    console.print(table)

    # Summary
    console.print()


# ============================================================================
# KC Tail Stats Analysis
# ============================================================================

_KC_TAIL_STATS_PARSER = None
_KC_TAIL_STATS_TOKENIZER = None


def _init_kc_tail_stats_worker(vocab_path: str):
    """Initialize worker for KC tail stats analysis."""
    global _KC_TAIL_STATS_PARSER, _KC_TAIL_STATS_TOKENIZER
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
    from kotogram.tokenizer import Tokenizer
    from train.kc import initialize_disallow_filter
    _KC_TAIL_STATS_PARSER = SudachiJapaneseParser()
    _KC_TAIL_STATS_TOKENIZER = Tokenizer.load(vocab_path)
    # Initialize disallow filter from tokenizer vocab
    compound_1_vocab = _KC_TAIL_STATS_TOKENIZER.field_vocabs.get("compound_1", {})
    initialize_disallow_filter(compound_1_vocab)


def _compute_tail_bag_for_sentence(sentence: str) -> Tuple[Tuple[int, ...], str]:
    """Compute TAIL_COMPOUND_1 bag for a single sentence.
    
    Returns the tail bag as a tuple of sorted IDs and the original sentence.
    """
    from kotogram.japanese_parser import KotogramFormat
    from train.kc import get_disallowed_positions, get_tail_ids

    kotogram = _KC_TAIL_STATS_PARSER.japanese_to_kotogram(
        sentence, KotogramFormat.TRAINING_MASK
    )
    encoded = _KC_TAIL_STATS_TOKENIZER.encode(kotogram)
    
    # Get disallowed positions using module-level cached disallow IDs
    disallowed_positions = get_disallowed_positions(encoded)
    
    # Use the shared get_tail_ids function, filtering UNK and disallowed positions
    tail_ids = get_tail_ids(encoded, "compound_1", filter_unk=True, disallowed_positions=disallowed_positions)
    return (tuple(tail_ids), sentence)


def curate_kc_tail_stats(db_path: str, sentence: str = None, filter_str: str = None):
    """
    Analyze TAIL_COMPOUND_1 distributions across the corpus.
    
    Shows frequency counts per unique tail bag, with the 8 most and 
    8 least common patterns. Optionally shows the tail bag for a given sentence.
    """
    import os
    from collections import Counter

    from rich.table import Table

    from train import paths

    # Find tokenizer
    vocab_path = os.path.join(paths.get_style_dataset_cache_dir(), "vocab.json")
    if not os.path.exists(vocab_path):
        console.print(f"[red]Vocab not found at {vocab_path}. Run 'bin/train_style --label' first.[/red]")
        return

    # Load sentences from corpus
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    cursor.execute("SELECT sentence FROM corpus")
    sentences = [row[0] for row in cursor.fetchall()]
    conn.close()

    console.print(f"[bold]KC Tail Stats:[/bold] Scanning {len(sentences):,} sentences for TAIL_COMPOUND_1...")

    # Run parallel scan
    num_workers = mp.cpu_count()
    tail_counts: Counter[Tuple[int, ...]] = Counter()
    # Track shortest sentence for each tail bag
    shortest_example: Dict[Tuple[int, ...], str] = {}

    with mp.Pool(
        num_workers,
        initializer=_init_kc_tail_stats_worker,
        initargs=(vocab_path,),
    ) as pool:
        with create_progress(console) as progress:
            task = progress.add_task("Computing tail bags...", total=len(sentences))

            for tail_bag, sent in pool.imap_unordered(_compute_tail_bag_for_sentence, sentences, chunksize=500):
                progress.advance(task)
                tail_counts[tail_bag] += 1
                # Track shortest example
                if tail_bag not in shortest_example or len(sent) < len(shortest_example[tail_bag]):
                    shortest_example[tail_bag] = sent

    # Load tokenizer for decoding
    from kotogram.tokenizer import Tokenizer
    tokenizer = Tokenizer.load(vocab_path)
    
    # Build reverse vocab for compound_1
    id_to_token = {v: k for k, v in tokenizer.field_vocabs.get("compound_1", {}).items()}
    
    def decode_tail(tail: Tuple[int, ...]) -> str:
        """Decode a tail bag to human-readable tokens."""
        tokens = [id_to_token.get(tid, f"#{tid}") for tid in tail]
        return " | ".join(tokens) if tokens else "(empty)"

    def truncate(s: str, max_len: int = 40) -> str:
        """Truncate a string for display."""
        return s[:max_len] + "..." if len(s) > max_len else s

    # Report results
    console.print()
    console.print(f"[bold]Summary:[/bold]")
    console.print(f"  Total sentences: {len(sentences):,}")
    console.print(f"  Distinct tail bags: {len(tail_counts):,}")
    console.print()

    # Most common tails
    console.print("[bold]8 Most Common Tail Bags:[/bold]")
    table_top = Table()
    table_top.add_column("Rank", style="dim")
    table_top.add_column("Count", style="cyan")
    table_top.add_column("TAIL_COMPOUND_1")
    table_top.add_column("Shortest Example", style="dim")
    
    for rank, (tail, count) in enumerate(tail_counts.most_common(8), 1):
        example = truncate(shortest_example.get(tail, ""))
        table_top.add_row(f"#{rank}", f"{count:,}", decode_tail(tail), example)
    console.print(table_top)

    # Optional: Show query sentence's tail bag
    if sentence:
        console.print()
        console.print("[bold]Query Sentence Tail Bag:[/bold]")
        
        # Compute tail bag for the query sentence
        from kotogram.japanese_parser import KotogramFormat
        from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
        from train.kc import get_disallowed_positions, get_tail_ids, initialize_disallow_filter
        
        # Initialize disallow filter (idempotent if already done)
        compound_1_vocab = tokenizer.field_vocabs.get("compound_1", {})
        initialize_disallow_filter(compound_1_vocab)
        
        parser = SudachiJapaneseParser()
        kotogram = parser.japanese_to_kotogram(sentence, KotogramFormat.TRAINING_MASK)
        encoded = tokenizer.encode(kotogram)
        
        # Get disallowed positions using module-level cached disallow IDs
        disallowed_positions = get_disallowed_positions(encoded)
        query_tail = tuple(get_tail_ids(encoded, "compound_1", filter_unk=True, disallowed_positions=disallowed_positions))
        
        query_count = tail_counts.get(query_tail, 0)
        # Find rank
        all_tails_sorted = tail_counts.most_common()
        query_rank = next((i for i, (t, _) in enumerate(all_tails_sorted, 1) if t == query_tail), None)
        
        table_query = Table()
        table_query.add_column("Rank", style="dim")
        table_query.add_column("Count", style="cyan")
        table_query.add_column("TAIL_COMPOUND_1")
        table_query.add_column("Query Sentence")
        
        rank_str = f"#{query_rank}" if query_rank else "(not in corpus)"
        table_query.add_row(rank_str, f"{query_count:,}", decode_tail(query_tail), truncate(sentence))
        console.print(table_query)

    # Least common tails
    console.print()
    console.print("[bold]8 Least Common Tail Bags:[/bold]")
    table_bottom = Table()
    table_bottom.add_column("Rank", style="dim")
    table_bottom.add_column("Count", style="cyan")
    table_bottom.add_column("TAIL_COMPOUND_1")
    table_bottom.add_column("Shortest Example", style="dim")

    least_common = tail_counts.most_common()[:-9:-1]  # Last 8, reversed
    for rank, (tail, count) in enumerate(least_common, 1):
        example = truncate(shortest_example.get(tail, ""))
        table_bottom.add_row(f"#{len(tail_counts) - 8 + rank}", f"{count:,}", decode_tail(tail), example)
    console.print(table_bottom)

    # Distinct element frequencies
    # Count how often each individual token appears across all sentences
    # Also track shortest sentence example per element
    element_counts: Counter[int] = Counter()
    element_example: Dict[int, str] = {}
    for tail_bag, count in tail_counts.items():
        example_sent = shortest_example.get(tail_bag, "")
        for token_id in tail_bag:
            element_counts[token_id] += count
            # Track shortest sentence containing this element
            if token_id not in element_example or len(example_sent) < len(element_example[token_id]):
                element_example[token_id] = example_sent

    console.print()
    # Apply filter if provided
    if filter_str:
        filtered_counts: Counter[int] = Counter()
        for token_id, count in element_counts.items():
            token_str = id_to_token.get(token_id, f"#{token_id}")
            if filter_str in token_str:
                filtered_counts[token_id] = count
        element_counts = filtered_counts
        console.print(f"[bold]Distinct TAIL_COMPOUND_1 Elements (filter: '{filter_str}'):[/bold] {len(element_counts):,} unique tokens")
    else:
        console.print(f"[bold]Distinct TAIL_COMPOUND_1 Elements:[/bold] {len(element_counts):,} unique tokens")

    # Most common elements
    console.print()
    console.print("[bold]8 Most Common Elements:[/bold]")
    table_elem_top = Table()
    table_elem_top.add_column("Rank", style="dim")
    table_elem_top.add_column("Count", style="cyan")
    table_elem_top.add_column("Element")
    table_elem_top.add_column("Shortest Example", style="dim")

    for rank, (token_id, count) in enumerate(element_counts.most_common(8), 1):
        token_str = id_to_token.get(token_id, f"#{token_id}")
        example = truncate(element_example.get(token_id, ""))
        table_elem_top.add_row(f"#{rank}", f"{count:,}", token_str, example)
    console.print(table_elem_top)

    # Least common elements
    console.print()
    console.print("[bold]8 Least Common Elements:[/bold]")
    table_elem_bottom = Table()
    table_elem_bottom.add_column("Rank", style="dim")
    table_elem_bottom.add_column("Count", style="cyan")
    table_elem_bottom.add_column("Element")
    table_elem_bottom.add_column("Shortest Example", style="dim")

    least_common_elems = element_counts.most_common()[:-9:-1]  # Last 8, reversed
    for rank, (token_id, count) in enumerate(least_common_elems, 1):
        token_str = id_to_token.get(token_id, f"#{token_id}")
        example = truncate(element_example.get(token_id, ""))
        table_elem_bottom.add_row(f"#{len(element_counts) - 8 + rank}", f"{count:,}", token_str, example)
    console.print(table_elem_bottom)


# ============================================================================
# Token Stats Analysis
# ============================================================================

_TOKEN_STATS_PARSER = None  # pylint: disable=invalid-name


def _init_token_stats_worker():
    """Initialize worker for token stats analysis."""
    global _TOKEN_STATS_PARSER  # pylint: disable=global-statement
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
    _TOKEN_STATS_PARSER = SudachiJapaneseParser()


def _get_tokens_for_sentence(sentence: str) -> Tuple[List[str], str]:
    """Parse sentence to kotogram and return (tokens, sentence) tuple."""
    from kotogram.kotogram import split_kotogram
    kotogram = _TOKEN_STATS_PARSER.japanese_to_kotogram(sentence)
    return (split_kotogram(kotogram), sentence)



def curate_token_stats(db_path: str):
    """
    Analyze kotogram token frequencies across the corpus.

    Shows the 8 most common and 8 least common actual token strings.
    """
    from collections import Counter

    from rich.table import Table

    # Load sentences from corpus
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    cursor.execute("SELECT sentence FROM corpus")
    sentences = [row[0] for row in cursor.fetchall()]
    conn.close()

    console.print(f"[bold]Token Stats:[/bold] Scanning {len(sentences):,} sentences for token frequencies...")

    # Run parallel scan
    num_workers = mp.cpu_count()
    token_counts: Counter[str] = Counter()
    # Track shortest sentence for each token
    shortest_example: Dict[str, str] = {}

    with mp.Pool(
        num_workers,
        initializer=_init_token_stats_worker,
    ) as pool:
        with create_progress(console) as progress:
            task = progress.add_task("Counting tokens...", total=len(sentences))

            for tokens, sent in pool.imap_unordered(
                _get_tokens_for_sentence,
                sentences,
                chunksize=500
            ):
                progress.advance(task)
                for token in tokens:
                    token_counts[token] += 1
                    # Track shortest example
                    if token not in shortest_example or len(sent) < len(shortest_example[token]):
                        shortest_example[token] = sent

    def truncate(s: str, max_len: int = 60) -> str:
        """Truncate a string for display."""
        return s[:max_len] + "..." if len(s) > max_len else s

    # Report results
    console.print()
    console.print("[bold]Summary:[/bold]")
    console.print(f"  Total sentences: {len(sentences):,}")
    console.print(f"  Distinct tokens: {len(token_counts):,}")
    console.print(f"  Total token occurrences: {sum(token_counts.values()):,}")
    console.print()

    # Most common tokens
    console.print("[bold]35 Most Common Tokens:[/bold]")
    table_top = Table()
    table_top.add_column("Rank", style="dim")
    table_top.add_column("Count", style="cyan")
    table_top.add_column("Token")
    table_top.add_column("Shortest Example", style="dim")

    for rank, (token, count) in enumerate(token_counts.most_common(35), 1):
        example = truncate(shortest_example.get(token, ""))
        table_top.add_row(f"#{rank}", f"{count:,}", token, example)
    console.print(table_top)

    # Least common tokens
    console.print()
    console.print("[bold]8 Least Common Tokens:[/bold]")
    table_bottom = Table()
    table_bottom.add_column("Rank", style="dim")
    table_bottom.add_column("Count", style="cyan")
    table_bottom.add_column("Token")
    table_bottom.add_column("Shortest Example", style="dim")

    least_common = token_counts.most_common()[:-9:-1]  # Last 8, reversed
    for rank, (token, count) in enumerate(least_common, 1):
        example = truncate(shortest_example.get(token, ""))
        table_bottom.add_row(f"#{len(token_counts) - 8 + rank}", f"{count:,}", token, example)
    console.print(table_bottom)

def curate_contrast_sentences(sentences: List[str]):
    """
    Compare KCs of multiple sentences.
    """
    from rich.table import Table

    from kotogram.analysis import grammars
    from kotogram.japanese_parser import KotogramFormat
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
    
    # Analyze sentences
    parser = SudachiJapaneseParser()
    kotograms = []
    for s in sentences:
        kotograms.append(parser.japanese_to_kotogram(s, KotogramFormat.TRAINING_MASK))
    
    # Use grammars for batch efficiency
    results = grammars(kotograms)
    
    # Collect all KCs and max weights
    all_kcs = set()
    kc_maps = []
    
    for res in results:
        kc_map = res.kc_top if res.kc_top else {}
        kc_maps.append(kc_map)
        all_kcs.update(kc_map.keys())
    
    # Sort KCs by SUM of weights across all sentences (aggregate importance)
    kc_list = []
    for kc_id in all_kcs:
        weights = [km.get(kc_id, 0.0) for km in kc_maps]
        sum_weight = sum(weights)
        kc_list.append((kc_id, sum_weight))
    
    # Sort descending by sum weight
    kc_list.sort(key=lambda x: x[1], reverse=True)
    sorted_kc_ids = [x[0] for x in kc_list]
    
    # Display
    table = Table(title="Contrast Sentences (Sentences x KCs)")
    table.add_column("Sentence", justify="left", style="bold blue", min_width=20)
    
    # Add KC columns
    for kc_id, _ in kc_list:
        table.add_column(f"KC {kc_id}", justify="center", style="cyan")
        
    # Add Rows
    for i, s in enumerate(sentences):
        row_cells = [s] # Sentence text
        for kc_id in sorted_kc_ids:
            if kc_id in kc_maps[i]:
                weight = kc_maps[i][kc_id]
                row_cells.append(f"[bold green]✔[/bold green] [grey70]{weight:.2f}[/grey70]")
            else:
                row_cells.append("[grey70]-[/grey70]")
        table.add_row(*row_cells)
        
    # Use a wide console to prevent column truncation
    wide_console = Console(width=2000)
    wide_console.print(table)





def curate_compare(db_path: str):
    """Compare corpus.db against .cache."""
    from kotogram import tokenizer
    from kotogram.kotogram import kotogram_to_japanese
    from kotogram.sudachi_japanese_parser import SudachiJapaneseParser
    from train import paths
    from train.dataset import StyleDataset
    
    cache_dir = paths.get_style_dataset_cache_dir()
    if not os.path.exists(cache_dir):
        console.print(f"[red]Cache not found at {cache_dir}[/red]")
        return
    
    console.print(f"[bold blue]Loading cache from {cache_dir}...[/bold blue]")
    
    # Load tokenizer first to decode
    vocab_path = os.path.join(cache_dir, "vocab.json")
    if not os.path.exists(vocab_path):
            console.print(f"[red]Vocab not found at {vocab_path}[/red]")
            return
            
    # Check for offsets before loading dataset to avoid FileNotFoundError crash
    from train.binary_io import EXT_OFFSETS
    if not os.path.exists(os.path.join(cache_dir, EXT_OFFSETS)):
        console.print(f"[red]Binary dataset (offsets) not found in {cache_dir}. Run 'drink' first?[/red]")
        return

    tok = tokenizer.Tokenizer.load(vocab_path)
    # Load Dataset (V2 Binary)
    ds = StyleDataset.from_multiple_tsv([], tok) # Args ignored in V2 factory
        
    console.print(f"[bold blue]Loading corpus from {db_path}...[/bold blue]")
    if not os.path.exists(db_path):
        console.print(f"[red]Database not found at {db_path}[/red]")
        return
    
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    c.execute("SELECT sentence, formality, gender, grammatic, register_ids FROM corpus")
    db_rows = c.fetchall()
    conn.close()
    
    from kotogram.japanese_parser import KotogramFormat
    
    # Instantiate parser for masking
    parser = SudachiJapaneseParser()

    # Map DB by sentence
    # Since we normalize at drink time, we can trust DB keys are normalized.
    # But we need to mask them to match the cache.
    db_map = {}
    
    with console.status("Indexing DB sentences (with masking)..."): 
        for row in db_rows:
            raw_sentence = row[0]
            
            # Apply Masking to match cache
            masked_kotogram = parser.japanese_to_kotogram(raw_sentence, fmt=KotogramFormat.TRAINING_MASK)
            masked_sentence = kotogram_to_japanese(masked_kotogram)
            
            # Note: Multiple raw sentences might map to the same masked sentence.
            # We just overwrite for now, assuming labels are consistent for the same masked content.
            # (e.g. "Hanako runs" and "Taro runs" -> "<given-name> runs" -> same labels)
            db_map[masked_sentence] = row
    
    # Invert vocab for surface
    if "surface" not in tok.field_vocabs:
        console.print("[red]Tokenizer missing surface field![/red]")
        return
    
    surface_vocab = tok.field_vocabs["surface"]
    id_to_surface = {v: k for k, v in surface_vocab.items()}
    
    disagreements = []
    missing_in_db = []
    missing_in_cache = [] # Hard to detect efficiently unless we iterate all DB?
    # We can detect missing_in_cache by checking against db_map keys set later.
    
    console.print("[bold blue]Comparing...[/bold blue]")
    
    # Iterate Cache
    seen_in_cache = set()
    
    from rich.progress import track
    # We can't iterate ds easily with tqdm if it's large without collate overhead?
    # Accessing by index is fast.
    
    for i in track(range(len(ds)), description="Scanning cache..."):
        sample = ds[i]
        
        # Reconstruct Sentence
        # sample.feature_ids["surface"] is Tensor or List
        raw_ids = sample.feature_ids["surface"]
        surf_ids = raw_ids.tolist() if hasattr(raw_ids, "tolist") else list(raw_ids)
        tokens = []
        for sid in surf_ids:
            # Skip special tokens if not part of text logic?
            # 0=PAD, 1=UNK, 2=CLS
            tokens.append(id_to_surface.get(sid, tokenizer.UNK_TOKEN))
        
        # Join without spaces for Japanese
        reconstructed_sent = "".join(tokens)
        
        # NOTE: reconstructed_sent is the raw Japanese text (surface tokens joined).
        # We compare this directly with the DB key.
        raw_sentence = reconstructed_sent
        
        # Debug only weird ones to reduce noise
        if "ᵖ" in raw_sentence or "ˢ" in raw_sentence:
             if len(seen_in_cache) < 5: # Limit spam
                 console.print(f"[yellow]Suspicious Reconstruct:[/yellow] '{raw_sentence}'")
        
        seen_in_cache.add(raw_sentence)
        
        if raw_sentence not in db_map:
            # Note: We track missing keys by their Raw/DB form
            missing_in_db.append(raw_sentence)
            continue
            
        # Compare
        db_row = db_map[raw_sentence]
        # db: (sent, f, g, gram, r_ids_str)
        # sample: formality_value, formality_pragmatic, gender_value, gender_pragmatic, grammaticality_label, register_labels (list of ints)
        
        diffs = []
        
        # Formality
        # DB: float or None. Cache: value (float) and prag (int).
        # DB stores NULL if unpragmatic. Cache stores value regardless but prag=0 flag.
        db_f = db_row[1]
        cache_f_prag = sample.formality_pragmatic
        cache_f_val = sample.formality_value
        
        if db_f is None:
            if cache_f_prag != 0:
                diffs.append(f"Formality: DB=None, Cache={cache_f_val} (Prag={cache_f_prag})")
        else:
            if cache_f_prag == 0:
                diffs.append(f"Formality: DB={db_f}, Cache=Unpragmatic")
            elif abs(db_f - cache_f_val) > 1e-4:
                 diffs.append(f"Formality: DB={db_f}, Cache={cache_f_val}")
                 
        # Gender
        db_g = db_row[2]
        cache_g_prag = sample.gender_pragmatic
        cache_g_val = sample.gender_value
        
        if db_g is None:
            # In strict logic: if cache is unpragmatic (g_prag=0), DB should be NULL.
            # But wait, DB stores raw gender value in `gender` column?
            # No, `scripts/curate` writes NULL if unpragmatic?
            # Inspect `curate.py`: `g_val if g_prag else None` -> Yes.
            if cache_g_prag != 0:
                 diffs.append(f"Gender: DB=None, Cache={cache_g_val} (Prag={cache_g_prag})")
        else:
            if cache_g_prag == 0:
                 diffs.append(f"Gender: DB={db_g}, Cache=Unpragmatic")
            elif abs(db_g - cache_g_val) > 1e-4:
                 diffs.append(f"Gender: DB={db_g}, Cache={cache_g_val}")

        # Grammaticality
        db_gram = db_row[3]
        cache_gram = sample.grammaticality_label
        
        if db_gram != cache_gram:
             diffs.append(f"Grammatic: DB={db_gram}, Cache={cache_gram}")
             
        # Registers
        # DB: "1,5" string. Cache: [1, 5] list.
        db_r_ids_str = db_row[4]
        if db_r_ids_str:
            db_r_ids = sorted([int(x) for x in db_r_ids_str.split(",") if x])
        else:
            db_r_ids = []
            
        cache_r_ids = sorted(list(sample.register_labels))
        # Note: dataset.py sample.register_labels might include 0 if empty list fallback?
        # Check dataset.py: `if not reg_list: reg_list = [0]`
        # DB stores Register 0? 0 is usually "None" or "Neutral"?
        # REGISTER_ID_TO_LABEL has entry for 0?
        # Typically 0 is "No Register" or "Neutral" if mapped.
        # DB usually stores empty string for no registers?
        # Inspect `curate.py`: `",".join(map(str, sorted(r_ids)))`
        # `analyze_chunk` returns `r_ids`.
        # `RegisterInference.infer` returns set of IDs.
        
        if db_r_ids != cache_r_ids:
             diffs.append(f"Registers: DB={db_r_ids}, Cache={cache_r_ids}")
        
        if diffs:
            disagreements.append({
                "sentence": reconstructed_sent,
                "diffs": diffs
            })

    # Check for missing in Cache
    for k in db_map:
        if k not in seen_in_cache:
            missing_in_cache.append(k)
            
    # Report
    if not disagreements and not missing_in_db and not missing_in_cache:
        console.print("[bold green]Perfect Match! No discrepancies found.[/bold green]")
        return
        
    if missing_in_db:
         console.print(f"[yellow]{len(missing_in_db)} sentences in Cache but missing in DB (e.g., '{missing_in_db[0]}')[/yellow]")
    
    if missing_in_cache:
         console.print(f"[yellow]{len(missing_in_cache)} sentences in DB but missing in Cache (e.g., '{missing_in_cache[0]}')[/yellow]")
         
    if disagreements:
        console.print(f"[red]Found {len(disagreements)} Disagreements:[/red]")
        count = 0
        for d in disagreements:
            if count >= 10:
                console.print(f"... and {len(disagreements) - 10} more.")
                break
            console.print(f"[bold]{d['sentence']}[/bold]")
            for diff in d['diffs']:
                console.print(f"  - {diff}")
            count += 1















def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    

    upsert_doc = """
    Update or insert a manual sentence entry in the corpus.
    
    Grammar Operations:
      --grammar accept a comma-separated list of operations.
      '+gpID' adds the grammar point to the positive set (and removes from negative).
      '-gpID' adds the grammar point to the negative set (and removes from positive).
      
    Invariants:
      - Positive and Negative grammar sets are always disjoint.
      - IDs must exist in the 'grammar' table.
      
    Examples:
      curate upsert "こんにちは" --grammar "+gp0001"
      curate upsert "こんにちは" --grammar "+gp0001,-gp0002"
      curate upsert "こんにちは" --formality formal --gender feminine
      curate upsert "新しい文" --allow-insert --formality neutral
    """
    upsert_parser = subparsers.add_parser(
        "upsert", 
        help="Update or insert manual sentence",
        description=upsert_doc,
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    upsert_parser.add_argument("sentence", nargs="?", help="Japanese sentence to upsert (optional if --sentences is used)")
    upsert_parser.add_argument("--sentences", help="Path to file containing sentences (one per line)")
    upsert_parser.add_argument(
        "--formality",
        choices=["very_casual", "casual", "neutral", "formal", "very_formal", "unpragmatic"],
        help="Formality override"
    )
    upsert_parser.add_argument(
        "--gender",
        choices=["masculine", "feminine", "neutral", "unpragmatic"],
        help="Gender override"
    )
    upsert_parser.add_argument(
        "--grammar",
        type=str,
        help="Update positive/negative grammar labels (e.g. '+gp0001,-gp0002'). Invariants: Positive and negative sets are disjoint.",
    )
    upsert_parser.add_argument(
        "--grammatic",
        type=int,
        choices=[0, 1],
        help="Force grammatical status (1=grammatic, 0=agrammatic)",
    )
    upsert_parser.add_argument("--db-path", default="data/corpus.db", help="Path to database")
    upsert_parser.add_argument("--allow-insert", action="store_true", help="Allow inserting new sentences")



    # Show command
    show_parser = subparsers.add_parser("show", help="Show labels for a sentence (Calculated)")
    show_parser.add_argument("sentence", help="Japanese sentence to analyze")
    
    # Read command
    read_parser = subparsers.add_parser("read", help="Read labels for a sentence from DB")
    read_parser.add_argument("sentence", help="Japanese sentence to lookup")
    read_parser.add_argument("--db-path", default="data/corpus.db", help="Path to database")

    # Summary command
    summary_parser = subparsers.add_parser("summary", help="Print corpus statistics from DB")
    summary_parser.add_argument("--db-path", default="data/corpus.db", help="Path to database")
    
    # Distinct command
    distinct_parser = subparsers.add_parser("distinct", help="Print distinct style combinations")
    distinct_parser.add_argument("--db-path", default="data/corpus.db", help="Path to database")
    distinct_parser.add_argument("--include-ungrammatic", action="store_true", help="Include ungrammatic sentences")
    
    # Compare command
    compare_parser = subparsers.add_parser("compare", help="Compare DB with Cache")
    compare_parser.add_argument("--db-path", default="data/corpus.db", help="Path to database")



    parser_contrast_s = subparsers.add_parser("contrast-sentences", help="Contrast multiple sentences")
    parser_contrast_s.add_argument("sentences", nargs="+", help="Sentences to compare")

    # KC Families command
    parser_kc_fam = subparsers.add_parser("kc-families", help="Show KC target families for a sentence")
    parser_kc_fam.add_argument("sentence", help="Japanese sentence to analyze")

    # Find matches command
    parser_find = subparsers.add_parser("find-kc-matches", help="Find sentences matching KC query")
    parser_find.add_argument("query", help="KC Query (e.g. +458,-964)")
    parser_find.add_argument("--db-path", default="data/corpus.db", help="Path to corpus.db")
    parser_find.add_argument("--index-path", default="data/corpus-kc-index.db", help="Path to index db")

    # Compress command
    compress_parser = subparsers.add_parser("compress", help="Vacuum the database")
    compress_parser.add_argument("--db-path", default="data/corpus.db", help="Path to database")

    # KC Lint command
    parser_kc_lint = subparsers.add_parser("kc-lint", help="Scan corpus for KC issues")
    parser_kc_lint.add_argument("--db-path", default="data/corpus.db", help="Path to corpus.db")

    # KC Hash command
    parser_kc_hash = subparsers.add_parser("kc-hash", help="Analyze hash collisions for sparse KC families")
    parser_kc_hash.add_argument("--db-path", default="data/corpus.db", help="Path to corpus.db")

    # KC Tail Stats command
    parser_kc_tail_stats = subparsers.add_parser("kc-tail-stats", help="Analyze tail bag distributions")
    parser_kc_tail_stats.add_argument("sentence", nargs="?", default=None, help="Optional sentence to show in context")
    parser_kc_tail_stats.add_argument("--db-path", default="data/corpus.db", help="Path to corpus.db")
    parser_kc_tail_stats.add_argument("--filter", dest="filter_str", default=None, help="Filter elements containing this string")

    # Token Stats command
    parser_token_stats = subparsers.add_parser("token-stats", help="Show most/least common kotogram tokens")
    parser_token_stats.add_argument("--db-path", default="data/corpus.db", help="Path to corpus.db")

    # Clone Empty command
    parser_clone = subparsers.add_parser("clone-empty", help="Clone schema to a new empty database")
    parser_clone.add_argument("--empty-db", required=True, help="Path to the new empty database (output)")
    parser_clone.add_argument("--db-path", default="data/corpus.db", help="Path to source database (input)")
    parser_clone.add_argument("--overwrite", action="store_true", help="Overwrite output database if it exists")

    # Study command - PNU hard negative mining
    parser_study = subparsers.add_parser("study", help="PNU-based hard negative/positive mining for grammar points")
    parser_study.add_argument("grammar_label", help="Grammar point label (e.g., gp0888)")
    parser_study.add_argument("--apply", action="store_true", help="Apply curated labels to database (run after manual review)")
    parser_study.add_argument("--batch-size", type=int, default=32, help="Batch size for training")
    parser_study.add_argument("--top-k", type=int, default=500, help="Number of candidates to generate")
    parser_study.add_argument("--device", type=str, default=None, help="Device to train on (default: auto-detect)")
    parser_study.add_argument("--quick", action="store_true", help="Quick mode: fewer epochs for testing")
    parser_study.add_argument("--seed", type=int, default=None, help="Random seed for reproducible evaluation sampling (default: random)")
    parser_study.add_argument("--full-pos", action="store_true", help="Evaluate all unlabeled sentences and find high-certainty positives (>99%%)")

    args = parser.parse_args()
    if args.command == "upsert":
        if args.sentences:
            if args.sentence:
                console.print("[red]Error: Cannot specify both 'sentence' and '--sentences'.[/red]")
                sys.exit(1)

            if not os.path.exists(args.sentences):
                console.print(f"[red]Error: File not found: {args.sentences}[/red]")
                sys.exit(1)
                
            with open(args.sentences, "r", encoding="utf-8") as f:
                batch_sentences = []
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#"):
                        batch_sentences.append(line)
                        
            curate_upsert_batch(
                batch_sentences, 
                args.formality, 
                args.gender, 
                args.grammar, 
                args.db_path, 
                args.allow_insert,
                grammatic=args.grammatic
            )
        elif args.sentence:
            curate_upsert(
                args.sentence, 
                args.formality, 
                args.gender, 
                args.grammar, 
                args.db_path, 
                args.allow_insert,
                grammatic=args.grammatic
            )
        else:
            console.print("[red]Error: Must specify 'sentence' or '--sentences'.[/red]")
            sys.exit(1)

    elif args.command == "show":
        curate_show(args.sentence)
    elif args.command == "read":
        curate_read(args.sentence, args.db_path)
    elif args.command == "summary":
        curate_summary(args.db_path)
    elif args.command == "distinct":
        curate_distinct(args.db_path, args.include_ungrammatic)
    elif args.command == "compare":
        curate_compare(args.db_path)

    elif args.command == "contrast-sentences":
        curate_contrast_sentences(args.sentences)
    elif args.command == "find-kc-matches":
        curate_find_kc_matches(args.query, args.db_path, args.index_path)
    elif args.command == "kc-families":
        curate_kc_families(args.sentence)
    elif args.command == "kc-lint":
        curate_kc_lint(args.db_path)
    elif args.command == "kc-hash":
        curate_kc_hash(args.db_path)
    elif args.command == "kc-tail-stats":
        curate_kc_tail_stats(args.db_path, args.sentence, args.filter_str)
    elif args.command == "token-stats":
        curate_token_stats(args.db_path)
    elif args.command == "clone-empty":
        curate_clone_empty(args.db_path, args.empty_db, args.overwrite)
    elif args.command == "study":
        # Call the curate_study_grammar_label.py script
        import subprocess
        script_path = os.path.join(os.path.dirname(__file__), "curate_study_grammar_label.py")
        cmd = [sys.executable, script_path, args.grammar_label]
        if args.apply:
            cmd.append("--apply")
        if args.batch_size != 32:
            cmd.extend(["--batch-size", str(args.batch_size)])
        if args.top_k != 500:
            cmd.extend(["--top-k", str(args.top_k)])
        if args.device:
            cmd.extend(["--device", args.device])
        if args.quick:
            cmd.append("--quick")
        if args.seed is not None:
            cmd.extend(["--seed", str(args.seed)])
        if args.full_pos:
            cmd.append("--full-pos")
        
        # Run without capturing output so user can see progress
        subprocess.run(cmd, check=True)


if __name__ == "__main__":
    mp.set_start_method("spawn", force=True)
    main()
