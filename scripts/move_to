#!/usr/bin/env python3
import argparse
import glob
import os
import re
import sys

def setup_args():
    parser = argparse.ArgumentParser(description="Move sentences between Japanese dataset files.")
    subparsers = parser.add_subparsers(dest='command', required=True)

    # Subparser for 'grammatic' command
    parser_gram = subparsers.add_parser('grammatic', help="Move sentence from agrammatic source to grammatic target.")
    parser_gram.add_argument('sentence', type=str, help=" The sentence to move.")

    # Subparser for 'agrammatic' command
    parser_agram = subparsers.add_parser('agrammatic', help="Move sentence from grammatic source to agrammatic target.")
    parser_agram.add_argument('sentence', type=str, help="The sentence to move.")
    
    return parser

def move_sentence(sentence: str, source_pattern: str, target_file: str):
    """
    Finds lines where the 3rd column (sentence text) matches `sentence` in source files.
    Removes them from source files and appends them to `target_file`.
    """
    found_lines = []
    
    # Identify source files
    source_files = glob.glob(source_pattern)
    if not source_files:
        print(f"No source files found matching pattern: {source_pattern}")
        return

    files_modified = 0

    for s_file in source_files:
        with open(s_file, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        
        new_lines = []
        file_matches = []
        from scripts.jpn_tsv import parse_tsv
        for line in lines:
            # Strict parsing: invalid lines will raise ValueError and stop the script
            s = parse_tsv(line)
            
            if s == sentence:
                file_matches.append(line)
            else:
                new_lines.append(line)
        
        if file_matches:
            found_lines.extend(file_matches)
            # Rewrite the source file without the matched lines
            with open(s_file, 'w', encoding='utf-8') as f:
                f.writelines(new_lines)
            print(f"Removed {len(file_matches)} line(s) from {s_file}")
            files_modified += 1

    if not found_lines:
        print(f"Sentence '{sentence}' not found in any source files.")
        return

    # Append to target file
    if not os.path.exists(target_file):
        print(f"Target file {target_file} does not exist. Creating it.")
        # Ensure directory exists
        os.makedirs(os.path.dirname(os.path.abspath(target_file)), exist_ok=True)
    
    with open(target_file, 'a', encoding='utf-8') as f:
        # Ensure we don't append to the end of the last line if it's missing a newline
        # But standard TSV processing usually expects clean files. 
        # For safety, we can just write.
        # However, purely appending might require a leading newline if the file doesn't end with one.
        # Let's check the target file end if it exists.
        if os.path.exists(target_file) and os.path.getsize(target_file) > 0:
            with open(target_file, 'rb') as check_f:
                check_f.seek(-1, 2)
                last_char = check_f.read(1)
                if last_char != b'\n':
                    f.write('\n')
        
        f.writelines(found_lines)
    
    print(f"Appended {len(found_lines)} line(s) to {target_file}")

def main():
    parser = setup_args()
    args = parser.parse_args()

    # Determine paths relative to the script location or current working directory?
    # Request implies `data/` directory. Assuming script is run from project root or `scripts/`.
    # To be safe, we can try to locate `data/` relative to the script if possible, or just use `data/`
    # and expect the user to run it from project root.
    # Given the request says "Call like 'move_to ...'", user likely adds to path or runs from root.
    # I will assume project root for `data/` paths as per typical usage in this repo.
    
    # Resolve absolute paths based on typical project structure (assuming script in scripts/)
    script_dir = os.path.dirname(os.path.abspath(__file__))
    project_root = os.path.dirname(script_dir)
    data_dir = os.path.join(project_root, 'data')

    if args.command == 'grammatic':
        # Source: data/jpn_agrammatic_*.tsv
        source_pattern = os.path.join(data_dir, 'jpn_agrammatic_*.tsv')
        # Target: data/jpn_sentences.tsv
        target_file = os.path.join(data_dir, 'jpn_sentences.tsv')
        move_sentence(args.sentence, source_pattern, target_file)

    elif args.command == 'agrammatic':
        # Source: data/jpn_sentences*.tsv
        source_pattern = os.path.join(data_dir, 'jpn_sentences*.tsv')
        # Target: data/jpn_agrammatic_curated.tsv
        target_file = os.path.join(data_dir, 'jpn_agrammatic_curated.tsv')
        move_sentence(args.sentence, source_pattern, target_file)

if __name__ == "__main__":
    main()
