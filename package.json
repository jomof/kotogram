{
  "name": "kotogram",
  "version": "0.0.21",
  "description": "A dual Python/TypeScript library for Japanese text parsing and encoding using kotogram format",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.dist.json",
    "build:watch": "tsc --watch",
    "test": "npm run compile && node --test test-dist/tests-ts/*.js",
    "clean": "tsc --build --clean && rimraf dist test-dist",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "lint": "gts lint",
    "compile": "tsc --build tsconfig.json",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "keywords": [
    "japanese",
    "nlp",
    "sudachi",
    "parser",
    "tokenizer",
    "kotogram",
    "typescript"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jomof/kotogram.git"
  },
  "bugs": {
    "url": "https://github.com/jomof/kotogram/issues"
  },
  "homepage": "https://github.com/jomof/kotogram#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "gts": "^7.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.6.3",
    "@types/node": "^25.0.3"
  }
}
