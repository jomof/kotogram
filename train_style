from kotogram import locations
from kotogram.model import (
    NUM_FORMALITY_PRAGMATIC_CLASSES,
    NUM_GENDER_PRAGMATIC_CLASSES,
    NUM_GRAMMATICALITY_CLASSES,
    ModelConfig,
)
from kotogram.tokenizer import Tokenizer
from train import io as train_io
from train import paths as train_paths
from train.config import (
    DataLoaderSettings,
    HardwareConfig,
    KCConfig,
    TrainerConfig,
)
from train.train_style_view import (
    PreprocessingResult,
    TrainStyleDiagnosticsView,
    TrainStyleView,
)

# Global view instance for display output
_view: TrainStyleView = TrainStyleDiagnosticsView()


PROJECT_ROOT = os.path.dirname(os.path.abspath(__file__))

# Import epoch specification parser (supports absolute "10" and relative "+5" syntax)
from train.epoch_spec import parse_epoch_spec  # pylint: disable=wrong-import-position


def get_device_info() -> tuple[int, str]:
    """Detect the number and type of available devices."""
    import torch
    if torch.cuda.is_available():
        return torch.cuda.device_count(), "CUDA"
    if hasattr(torch.backends, "mps") and torch.backends.mps.is_available():
        return 1, "MPS"
    return 1, "CPU"





def run_command(cmd: List[str], env: dict, tee_log: Optional[str] = None) -> int:
    """Run a command, optionally teeing output to a log file."""
    cwd = PROJECT_ROOT
    if tee_log:
        # Use utility function for binary passthrough
        from train.subprocess_io import run_command_with_tee
        return run_command_with_tee(cmd, env, cwd, tee_log)
    result = subprocess.run(cmd, env=env, cwd=cwd, check=False)
    return result.returncode





# pylint: disable=too-many-locals



def handle_special_modes(args: argparse.Namespace) -> Optional[int]:
    """Handle special modes like --show-config, --show-model, and --report."""
    if args.show_config:
        _view.on_config_json(TrainerConfig().to_dict())
        return 0

    if args.show_model:
        # Build model and show architecture report
        from kotogram.model import InferenceClassifier
        from train.architecture_report import generate_architecture_report

        # Try to load real vocab sizes from tokenizer if available
        tokenizer_path = os.path.join(locations.get_style_output_dir(), "tokenizer.json")
        if os.path.exists(tokenizer_path):
            tokenizer = Tokenizer.load(tokenizer_path)
            vocab_sizes = tokenizer.get_vocab_sizes()
        else:
            # Fall back to default vocab sizes for architecture visualization
            vocab_sizes = {
                "surface": 16384,
            }

        config = ModelConfig(vocab_sizes=vocab_sizes)
        model = InferenceClassifier(config)
        report = generate_architecture_report(model)
        _view.on_architecture_report(report)
        return 0

    if args.report:
        # Just pass through to inner script
        return run_command([sys.executable, "-m", "scripts.train_style", "--report"], os.environ.copy())

    return None


def run_preprocessing(
    args: argparse.Namespace,
    env: dict,
) -> bool:
    """Run preprocessing/labeling phase."""
    style_cache_dir = train_paths.get_style_dataset_cache_dir()
    offsets_bin = os.path.join(style_cache_dir, "offsets.bin")

    skip_label = False
    if os.path.exists(offsets_bin) and not args.force_relabel:
        skip_label = True
        _view.on_preprocessing_cached()

    _view.on_preprocessing_start()

    t_label_start = time.perf_counter()

    if not skip_label:
        data_dir = train_paths.get_data_dir()
        corpus_db_path = os.path.join(data_dir, "corpus.db")

        if not os.path.exists(corpus_db_path):
            _view.on_preprocessing_error(f"corpus.db not found at {corpus_db_path}.")
            _view.on_preprocessing_error("train_style now requires corpus.db for labeling.")
            _view.on_preprocessing_error("Please run 'curate drink' to generate the database.")
            return False

        label_cmd = [
            sys.executable,
            "-m",
            "scripts.label",
            "--source-db",
            corpus_db_path,
        ]

        if args.force_relabel:
            label_cmd.append("--force-relabel")

        # Legacy pattern arguments are dropped as per user request ("Don't fall back")

        _view.on_preprocessing_db_source()
        ret = run_command(label_cmd, env)
        duration = time.perf_counter() - t_label_start
        if ret != 0:
            _view.on_preprocessing_error("Preprocessing failed!")
            return False
    else:
        duration = time.perf_counter() - t_label_start

    # Report size if possible
    dataset_size = 0
    if os.path.exists(offsets_bin):
        sz = os.path.getsize(offsets_bin)
        dataset_size = sz // 4 - 1

    _view.on_preprocessing_complete(
        PreprocessingResult(dataset_size=dataset_size, cached=skip_label, duration_s=duration)
    )
    return True


# pylint: disable=too-many-positional-arguments
def build_trainer_config(
    args: argparse.Namespace,
    env: dict,
    grad_accum_steps: int,
    loaded_config: Optional[TrainerConfig],
    current_kc_epochs: int = 0,
    current_style_epochs: int = 0,
) -> TrainerConfig:
    """Build the TrainerConfig object from arguments.

    Args:
        current_kc_epochs: Number of KC epochs already completed (for +N syntax)
        current_style_epochs: Number of style epochs already completed (for +N syntax)
    """
    trainer_kwargs: Dict[str, Any] = {
        "learning_rate": args.learning_rate,
        "grad_accum_steps": grad_accum_steps,
        "hardware": HardwareConfig(
            cpu_reserve_cores=int(env.get("CPU_RESERVE_CORES", 2)),
        ),
        "dataloader": DataLoaderSettings(
            num_workers=args.dataloader_num_workers,
        ),
        # KC Config
        "kc_config": KCConfig(
            # Pass args that were explicitly set, otherwise rely on default
            # Note: 0 is a valid value for skip_first_metrics, so we use args.kc_skip_first_metrics directly
            skip_first_metrics=args.kc_skip_first_metrics,
            # For optional floats/ints, standard pattern:
            **({
                "kl_sparse_weight": args.kl_sparse_weight
            } if args.kl_sparse_weight is not None else {}),
            **({
                "freeze_encoder_epochs": args.kc_freeze_encoder_epochs
            } if args.kc_freeze_encoder_epochs is not None else {}),
            **({
                "entropy_weight": args.kc_entropy_weight
            } if args.kc_entropy_weight is not None else {}),
        ),
        # Runtime flags
        "retrain": args.retrain,
        "sample_ratio": args.percent / 100.0 if args.percent else 1.0,
        "ramp_step": args.ramp / 100.0 if args.ramp else 0.0,
        "label_only": args.label,
        "report_only": args.report,
    }

    # Parse epoch specs (supports both absolute "10" and relative "+5" syntax)
    parsed_epochs = parse_epoch_spec(args.epochs, current_style_epochs)
    if parsed_epochs is not None:
        trainer_kwargs["epochs"] = parsed_epochs

    if args.batch_size is not None:
        trainer_kwargs["batch_size"] = args.batch_size
    if args.formality_weight is not None:
        trainer_kwargs["formality_loss_weight"] = args.formality_weight
    if args.gender_weight is not None:
        trainer_kwargs["gender_loss_weight"] = args.gender_weight
    if args.grammaticality_weight is not None:
        trainer_kwargs["grammaticality_loss_weight"] = args.grammaticality_weight

    # Handle KC epochs logic (supports +N syntax, SSOT: rely on TrainerConfig default if not specified)
    parsed_kc_epochs = parse_epoch_spec(args.kc_epochs, current_kc_epochs)
    if parsed_kc_epochs is not None:
        trainer_kwargs["kc_epochs"] = parsed_kc_epochs
    elif loaded_config:
        trainer_kwargs["kc_epochs"] = loaded_config.kc_epochs

    return TrainerConfig(**trainer_kwargs)


# pylint: disable=too-many-locals
def generate_and_save_config(
    args: argparse.Namespace,
    env: dict,
    should_resume: bool,
    grad_accum_steps: int,
) -> str:
    """Generate and save the unified configuration file."""
    # pylint: disable=import-outside-toplevel
    from train.paths import get_style_history_dir
    history_dir = get_style_history_dir()
    cache_dir = train_paths.get_cache_dir()

    config_path = os.path.join(history_dir, "config.json")

    # Load tokenizer
    output_dir = locations.get_style_output_dir()
    os.makedirs(output_dir, exist_ok=True)
    tokenizer_path_final = os.path.join(output_dir, "tokenizer.json")
    tokenizer_path_cache = os.path.join(cache_dir, "style_dataset", "vocab.json")

    # Ensure tokenizer is in the final output location (models/style/tokenizer.json)
    # This is the single source of truth for training and inference.
    if os.path.exists(tokenizer_path_cache):
        # Save inference-only tokenizer (encoder fields only) to model output dir
        cached_tok = Tokenizer.load(tokenizer_path_cache)
        train_io.save_tokenizer(cached_tok, tokenizer_path_final, inference_only=True)
        _view.on_tokenizer_staged(tokenizer_path_final)
    if not os.path.exists(tokenizer_path_final):
        # If no cache and no existing final tokenizer, create a fresh one (e.g. first run)
        _view.on_tokenizer_created(tokenizer_path_final)
        train_io.save_tokenizer(Tokenizer(), tokenizer_path_final)

    # Load strictly from the final location
    _view.on_tokenizer_loaded(tokenizer_path_final)
    tokenizer = Tokenizer.load(tokenizer_path_final)

    # Define KC target specs (Handled dynamically by inner script)
    # Create configs
    config_loaded = False
    model_config = None  # type: ignore # Fix Pylint E0606
    loaded_trainer_config = None
    if should_resume and os.path.exists(config_path):
        _view.on_config_resuming(config_path)
        model_config, loaded_trainer_config = TrainerConfig.load_config(config_path)
        # KC is always enabled; no override needed
        config_loaded = True

    if not config_loaded:
        model_config = ModelConfig(
            vocab_sizes=tokenizer.get_vocab_sizes(),
            num_formality_pragmatic_classes=NUM_FORMALITY_PRAGMATIC_CLASSES,
            num_gender_pragmatic_classes=NUM_GENDER_PRAGMATIC_CLASSES,
            num_grammaticality_classes=NUM_GRAMMATICALITY_CLASSES,
            d_model=args.embed_dim,
            hidden_dim=args.hidden_dim,
            num_layers=args.num_layers,
            num_heads=args.num_heads,
            # KC Config
            kc_vocab_size=args.kc_k,
        )

    # Read history to get current epoch counts (for +N syntax support)
    from train import history
    history_dir = get_style_history_dir()
    history_path = os.path.join(history_dir, "training-history.tsv")
    events = history.read_events(history_path) if os.path.exists(history_path) else []
    current_kc_epochs = sum(1 for e in events if isinstance(e, history.KcEpochEvent))
    current_style_epochs = sum(1 for e in events if isinstance(e, history.StyleEpochEvent))

    # Build TrainerConfig
    trainer_config = build_trainer_config(
        args, env, grad_accum_steps, loaded_trainer_config,
        current_kc_epochs=current_kc_epochs,
        current_style_epochs=current_style_epochs,
    )

    # Save unified config
    import json

    assert model_config is not None
    combined_config = cast(Dict[str, Any], model_config.to_dict())
    combined_config["trainer"] = trainer_config.to_dict()

    if args.show_config:
        _view.on_config_json(trainer_config.to_dict())
        return ""

    new_config_json = json.dumps(combined_config, indent=2)
    write_config = True
    if os.path.exists(config_path):
        with open(config_path, "r", encoding="utf-8") as f:
            if f.read() == new_config_json:
                write_config = False

    if write_config:
        with open(config_path, "w", encoding="utf-8") as f:
            f.write(new_config_json)
        _view.on_config_saved(config_path)
    else:
        _view.on_config_unchanged(config_path)

    return config_path

