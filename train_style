    # Phase 2: Configuration
    config_path = generate_and_save_config(args, env, explicit_resume, grad_accum_steps)
    if args.show_config:
        return 0

    if args.label:
        print("Labeling only requested. Exiting.")
        return 0

    if args.confusion:
        return run_confusion_phase(args, env, config_path)

    # Phase 3: Training
    ret = run_training_phase(
        args, env, config_path, launcher, use_mp_launcher, num_devices
    )
    if ret != 0:
        return ret

    # Printing handled by run_training_phase

    # Phase 4: Confusion evaluation (after training)
    if not args.no_confusion:
        print("Generating confusion report...")
        run_confusion_phase(args, env, config_path)
    else:
        print("Skipping confusion report (--no-confusion)")

