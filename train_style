def main() -> int:
    args = parse_arguments()

    ret = handle_special_modes(args)
    if ret is not None:
        return ret

    # Setup environment
    env = os.environ.copy()

    # Set TRAIN_ROOT if not already set
    train_root = env.get("TRAIN_ROOT", ".")
    if not os.path.isabs(train_root):
        train_root = os.path.join(PROJECT_ROOT, train_root)
    env["TRAIN_ROOT"] = train_root
    # Sync TRAIN_ROOT to os.environ so train.profile functions use the correct absolute path
    os.environ["TRAIN_ROOT"] = train_root

    # Enable MPS fallback for unsupported ops (Mac Apple Silicon)
    env["PYTORCH_ENABLE_MPS_FALLBACK"] = "1"
    # Silence OMP warnings and prevent thread oversubscription
    env["OMP_NUM_THREADS"] = "1"
    # Force 127.0.0.1 for master addr to avoid DNS lookups
    env["MASTER_ADDR"] = "127.0.0.1"

    # Profiling support
    from train.profile import get_profile_dir, profiling_enabled

    profile_dir = ""
    if profiling_enabled():
        p_dir = get_profile_dir()
        if p_dir:
            profile_dir = p_dir
            os.makedirs(profile_dir, exist_ok=True)
            if not args.show_config:
                print(f"Profiling enabled. Results will be written to: {profile_dir}")

    # Get paths from locations module
    # Get paths from locations module
    # from kotogram import locations (moved to global)


    cache_dir = locations.get_cache_dir()
    support_dir = locations.get_style_support_dir()
    output_dir = locations.get_style_output_dir()

    # Set default agrammatic pattern
    gram_data_pattern, agrammatic_pattern = get_data_patterns(args)

    # Print configuration header
    print_training_banner(args, gram_data_pattern, agrammatic_pattern, output_dir)

    # Create directories
    os.makedirs(cache_dir, exist_ok=True)
    os.makedirs(support_dir, exist_ok=True)
    if not args.label:
        os.makedirs(output_dir, exist_ok=True)

    # Auto-resume logic
    checkpoint_path = os.path.join(support_dir, "checkpoint.pt")

    # Capture original --resume flag value before auto-resume may modify it
    # Used for config generation to keep config stable across runs
    explicit_resume = args.resume
    if not args.resume and not args.retrain and os.path.exists(checkpoint_path):
        args.resume = True
        print(f"Auto-resume enabled (found checkpoint: {checkpoint_path})")

    # Determine process count and launcher
    num_devices, device_type = get_device_info()
    use_mp_launcher = False

    # Configure launcher based on device type and count
    if device_type == "CUDA" and num_devices > 1:
        launcher = ["torchrun", f"--nproc_per_node={num_devices}"]
    elif num_devices == 1:
        launcher = [sys.executable]
    else:
        # Simulate distributed on Mac/CPU with 2 processes to catch multi-process bugs.
        # Use custom MP launcher to avoid 35s torchrun overhead on Mac.
        # This handles the specific "fake distributed" case if detected (rare/manual override?)
        # For now, let's trust get_device_info.
        # Note: The original logic had a fallback for num_gpus (from get_num_gpus returning 0) -> num_devices=2
        # get_device_info now returns 1, "CPU" if no GPU.
        # To preserve the mp-simulation logic, we check for dev/testing env var or argument?
        # The prompt implies we want to see "actual usage".
        # If the user was relying on the fallback `else` block (num_gpus=0 implied CPU simulation),
        # we strictly default to 1 CPU now.
        # PROMPT: "Will all 4 GPUs be used?" -> Focused on production.
        # I will stick to 1 CPU default for "CPU" type unless explicitly simulation requested.
        # Wait, the original code had:
        # if num_gpus > 1: ... elif num_gpus == 1: ... else: num_devices=2 ...
        # get_num_gpus returned 0 for CPU.
        # So essentially CPU/Unknown was FORCED to 2-process simulation? That seems odd for production CPU training.
        # It was likely for testing distributed logic on CPU machines.
        # I should probably preserve that behavior if it helps dev, OR simplify.
        # But for the user request "how many GPUs... will be used", accurate logging is key.
        # I will trust the logic:
        pass

    # Re-eval launcher logic to match previous structure but with types
    if device_type == "CUDA" and num_devices > 1:
        launcher = ["torchrun", f"--nproc_per_node={num_devices}"]
    elif device_type == "CUDA" and num_devices == 1:
        launcher = [sys.executable]
    elif device_type == "MPS":
        num_devices = 1
        launcher = [sys.executable]
    else:
        # CPU case. Original code mapped 0 GPUs to 2 processes.
        # Let's check if we really want that.
        # "Simulate distributed on Mac/CPU with 2 processes to catch multi-process bugs."
        # This seems intended for dev.
        # For production CPU training, you might want 1 process?
        # I will preserve the original simulation logic for CPU to avoid breaking dev workflow,
        # but label it clearly.
        num_devices = 2
        use_mp_launcher = True
        launcher = ["mp-simulation", "(2 processes)"]
        device_type = "CPU (Simulated Distributed)"

    # Configure batch sizes
    micro_batch_size = args.batch_size if args.batch_size else 32
    target_global_batch_size = int(env.get("TARGET_GLOBAL_BATCH_SIZE", "128"))

    total_current_batch = num_devices * micro_batch_size
    if total_current_batch < target_global_batch_size:
        grad_accum_steps = target_global_batch_size // total_current_batch
    else:
        grad_accum_steps = 1
    grad_accum_steps = max(grad_accum_steps, 1)

    # Print effective configuration
    print("-" * 46)
    print("Effective Training Configuration:")
    print("-" * 46)
    print(f"  Devices:          {num_devices} ({device_type})")
    print(f"  Micro batch:      {micro_batch_size}")
    print(f"  Grad accum:       {grad_accum_steps}")
    print(f"  Effective batch:  {micro_batch_size * grad_accum_steps * num_devices}")
    print(f"  Launcher:         {' '.join(launcher)}")
    if args.pretrain_kc:
        print(f"  KC Epochs:        {args.kc_epochs} (freeze: {args.kc_freeze_encoder_epochs})")
        print(f"  KC Vocab (K):     {args.kc_k}")
        print(f"  KC Top-k:         {args.kc_topk}")
        print(f"  KC Targets:       {args.kc_target_heads}")
    print("-" * 46)
    print()

    # Phase 1: Preprocessing/Labeling
    if not run_preprocessing(args, env, gram_data_pattern, agrammatic_pattern):
