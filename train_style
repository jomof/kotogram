def run_training_phase(
    args: argparse.Namespace,
    env: dict,
    config_path: str,
    launcher: List[str],
) -> int:

    """Run the training phase using the generated configuration."""
    # pylint: disable=import-outside-toplevel
    from train.paths import get_style_history_dir

    history_dir = get_style_history_dir()
    # output_dir isn't used immediately here? Wait, let's look at 404 view.
    # It just continues to "Training Phase".
    # But look at line 682 in 405 view: output_dir = locations.get_style_output_dir().
    # Line 414 corruption replaced SOMETHING.
    # Previous code?
    # View 404 shows line 413: """Run the training phase..."""
    # So 414 was start of function body.
    # Was there `support_dir = ...` at start of body?
    # In Step 291 view, `run_training` (which became `run_training_phase`?) starts
    # So I should restore that (but with new import).
    output_dir = locations.get_style_output_dir()

    # Training Phase
    _view.on_training_start()

    # All parameters now passed via config.json
    train_args = [
        "-m",
        "scripts.train_style",
        "--config",
        config_path,
    ]
    if getattr(args, "mlflow", False):
        train_args.append("--mlflow")

    history_dir = get_style_history_dir()
    training_log = os.path.join(history_dir, "training.log")
    t_train_start = time.perf_counter()

    train_cmd = launcher + train_args
    ret = run_command(train_cmd, env, tee_log=training_log)

    duration = time.perf_counter() - t_train_start
    _view.on_training_duration(duration)
    if ret != 0:
        _view.on_training_error("")
        return ret

    _view.on_training_complete(output_dir, training_log)
    return 0






def parse_arguments() -> argparse.Namespace:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        description="Train style classifier (formality + gender + grammaticality) on Japanese sentence corpus",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # Load defaults from config classes as source of truth
    _trainer_defaults = TrainerConfig()
    _kc_defaults = KCConfig()
    _model_defaults = ModelConfig(vocab_sizes={})

    # Data options
    parser.add_argument(
        "--agrammatic-pattern",
        default=None,
        help="Pattern for agrammatic TSV files (default: $DATA_DIR/jpn_agrammatic*.tsv)",
    )
    parser.add_argument(
        "--no-agrammatic-data", action="store_true", help="Disable loading agrammatic data"
    )

    # Training options
    parser.add_argument("--epochs", type=str, default=None, help="Training epochs (e.g., '10' or '+5')")
    parser.add_argument("--batch-size", type=int, default=None, help="Batch size per device")
    # Pretraining options
    parser.add_argument("--embed-dim", type=int, default=_model_defaults.d_model, help=f"Model dimension (default: {_model_defaults.d_model})")
    parser.add_argument("--hidden-dim", type=int, default=_model_defaults.hidden_dim, help=f"Hidden layer dimension (default: {_model_defaults.hidden_dim})")
    parser.add_argument("--num-layers", type=int, default=_model_defaults.num_layers, help=f"Number of encoder layers (default: {_model_defaults.num_layers})")
    parser.add_argument("--num-heads", type=int, default=_model_defaults.num_heads, help=f"Number of attention heads (default: {_model_defaults.num_heads})")

    parser.add_argument("--learning-rate", type=float, default=_trainer_defaults.learning_rate, help=f"Base learning rate (default: {_trainer_defaults.learning_rate})")

    # Loss weights
    parser.add_argument("--formality-weight", type=float, default=None, help="Weight for formality loss")
    parser.add_argument("--gender-weight", type=float, default=None, help="Weight for gender loss")
    parser.add_argument("--grammaticality-weight", type=float, default=None, help="Weight for grammaticality loss")




    # Retrain flag (resume is now the default when checkpoints exist)
    parser.add_argument("--retrain", action="store_true", help="Retrain from scratch, ignoring checkpoints")

    # KC Pretraining options (KC is always enabled)
    # Use TrainerConfig default for help text to ensure Single Source of Truth
    default_kc_epochs = _trainer_defaults.kc_epochs
    parser.add_argument("--kc-epochs", type=str, default=None, help=f"KC epochs (e.g., '6' or '+2', default: {default_kc_epochs})")

    # ModelConfig defaults (kc_vocab_size)
    parser.add_argument("--kc-k", type=int, default=_model_defaults.kc_vocab_size, help=f"KC vocabulary size (default: {_model_defaults.kc_vocab_size})")

    # KCConfig defaults (freeze, kl-sparse, skip_metrics)
    parser.add_argument(
        "--kc-freeze-encoder-epochs", type=int, default=None, help="Epochs to freeze encoder (default: from config)"
    )
    parser.add_argument("--kl-sparse-weight", type=float, default=None, help=f"KL-sparse regularization weight (default: {_kc_defaults.kl_sparse_weight})")
    parser.add_argument("--kc-entropy-weight", type=float, default=None, help=f"Per-probability entropy penalty weight (default: {_kc_defaults.entropy_weight})")

    parser.add_argument(
        "--kc-batch-size",
        type=int,
        default=None,
        help="Explicit batch size for KC pretraining (overrides config/auto)",
    )
    parser.add_argument(
        "--kc-skip-first-metrics",
        type=int,
        default=_kc_defaults.skip_first_metrics,
        help=f"Skip diagnostic metrics gathering until epoch N (0=disabled, default: {_kc_defaults.skip_first_metrics})",
    )


    # Action flags
    parser.add_argument("--label", action="store_true", help="Run ONLY the labeling/preprocessing phase")
    parser.add_argument("--force-relabel", action="store_true", help="Force re-running labeling phase")
    parser.add_argument("--show-config", action="store_true", help="Print configuration as JSON and exit")
    parser.add_argument("--show-model", action="store_true", help="Show model architecture and exit")

    # Data sampling
    parser.add_argument("--percent", type=float, default=None, help="Percentage of data to use (1-100)")

    parser.add_argument("--report", action="store_true", help="Generate performance report and exit")
    parser.add_argument(
        "--mlflow",
        action="store_true",
        help="Enable MLflow experiment tracking for KC epochs",
    )

    # Adaptive data ramp
    parser.add_argument(
        "--ramp",
        type=float,
        default=0.0,
        help="Adaptive ramp: increase data by this %% each time GP PosP >= threshold (e.g. 10 = +10%%)",
    )

    # Performance options
    parser.add_argument(
        "--dataloader-num-workers",
        type=int,
        default=None,
        help="Number of DataLoader workers (None=auto-tune)",
    )

    return parser.parse_args()




def print_training_banner(
    args: argparse.Namespace,
    output_dir: str
) -> None:
    """Print the training configuration banner."""
    if args.show_config:
        return

    # Resolve paths for banner
    data_dir = train_paths.get_data_dir()
    corpus_db = os.path.join(data_dir, "corpus.db")

    freeze_str = str(args.kc_freeze_encoder_epochs) if args.kc_freeze_encoder_epochs is not None else "(default)"
    loss_config_str = (
        f"KLρ={KCConfig().kl_target_rho} w={args.kl_sparse_weight or KCConfig().kl_sparse_weight}"
        f" scale={KCConfig().rho_length_scale} cov={KCConfig().cov_penalty_weight}"
    )


    _view.on_config_banner(
        corpus_db=corpus_db,
        output_dir=output_dir,
        epochs=args.epochs,
        learning_rate=args.learning_rate,
        embed_dim=args.embed_dim,
        hidden_dim=args.hidden_dim,
        num_layers=args.num_layers,
        num_heads=args.num_heads,
        formality_weight=args.formality_weight,
        gender_weight=args.gender_weight,
        grammaticality_weight=args.grammaticality_weight,
        kc_epochs=args.kc_epochs,
        kc_k=args.kc_k,
        kc_freeze_str=freeze_str,
        kc_loss_config_str=loss_config_str,

        retrain=args.retrain,
        label_only=args.label,
        percent=args.percent,
    )


# pylint: disable=too-many-return-statements
def main() -> int:
    args = parse_arguments()

    ret = handle_special_modes(args)
    if ret is not None:
        return ret

    # Setup environment
    env = os.environ.copy()

    # Set TRAIN_ROOT if not already set
    train_root = env.get("TRAIN_ROOT", ".")
    if not os.path.isabs(train_root):
        train_root = os.path.join(PROJECT_ROOT, train_root)
    env["TRAIN_ROOT"] = train_root
    # Sync TRAIN_ROOT to os.environ so train.profile functions use the correct absolute path
    os.environ["TRAIN_ROOT"] = train_root

    # Enable MPS fallback for unsupported ops (Mac Apple Silicon)
    env["PYTORCH_ENABLE_MPS_FALLBACK"] = "1"
    # Silence OMP warnings and prevent thread oversubscription
    env["OMP_NUM_THREADS"] = "1"
    # Force 127.0.0.1 for master addr to avoid DNS lookups
    env["MASTER_ADDR"] = "127.0.0.1"

    # Ensure subprocesses use the project root in PYTHONPATH to pick up local changes
    python_path = env.get("PYTHONPATH", "")
    if python_path:
        env["PYTHONPATH"] = f"{PROJECT_ROOT}{os.pathsep}{python_path}"
    else:
        env["PYTHONPATH"] = PROJECT_ROOT

    # Profiling support
    from train.profile import get_profile_dir, profiling_enabled

    profile_dir = ""
    if profiling_enabled():
        p_dir = get_profile_dir()
        if p_dir:
            profile_dir = p_dir
            os.makedirs(profile_dir, exist_ok=True)
            if not args.show_config:
                _view.on_profiling_enabled(profile_dir)

    # Get paths from locations module
    # Get paths from locations module
    # from kotogram import locations (moved to global)


    cache_dir = train_paths.get_cache_dir()
    history_dir = train_paths.get_style_history_dir()
    output_dir = locations.get_style_output_dir()

    # Print configuration header
    print_training_banner(args, output_dir)

    # Create directories
    os.makedirs(cache_dir, exist_ok=True)
    os.makedirs(history_dir, exist_ok=True)
    if not args.label:
        os.makedirs(output_dir, exist_ok=True)

    # Resume is the default when continuation exists (unless --retrain)
    should_resume = False
    if not args.retrain:
        continuation_path = os.path.join(output_dir, "continuation.json")
        model_pt_path = os.path.join(output_dir, "model.pt")
        if os.path.exists(continuation_path) or os.path.exists(model_pt_path):
            should_resume = True
    else:
        # Clear training log so the new run starts fresh
        training_log = os.path.join(history_dir, "training.log")
        if os.path.exists(training_log):
            os.remove(training_log)

    # Determine process count and launcher
    num_devices, device_type = get_device_info()
    # Configure launcher based on device type and count
    # Support only single-device execution
    num_devices = 1
    launcher = [sys.executable]

    if device_type == "CUDA":
        # Even if multiple GPUs are available, we currently support only single-device training.

        pass
    elif device_type == "MPS":
        pass
    else:
        # CPU
        pass

    # Configure batch sizes
    micro_batch_size = args.batch_size if args.batch_size else 32
    target_global_batch_size = int(env.get("TARGET_GLOBAL_BATCH_SIZE", "128"))

    total_current_batch = num_devices * micro_batch_size
    if total_current_batch < target_global_batch_size:
        grad_accum_steps = target_global_batch_size // total_current_batch
    else:
        grad_accum_steps = 1
    grad_accum_steps = max(grad_accum_steps, 1)

    # Print effective configuration
    freeze_str = str(args.kc_freeze_encoder_epochs) if args.kc_freeze_encoder_epochs is not None else "(default)"
    _view.on_effective_config(
        num_devices=num_devices,
        device_type=device_type,
        micro_batch=micro_batch_size,
        grad_accum=grad_accum_steps,
        effective_batch=micro_batch_size * grad_accum_steps * num_devices,
        launcher=" ".join(launcher),
        kc_epochs=args.kc_epochs,
        kc_freeze_str=freeze_str,
        kc_k=args.kc_k,
    )

    # Phase 1: Preprocessing/Labeling
    if not run_preprocessing(args, env):
        return 1

    # Phase 2: Configuration
    config_path = generate_and_save_config(args, env, should_resume, grad_accum_steps)
    if args.show_config:
        return 0

    if args.label:
        _view.on_label_only_exit()
        return 0


    # Phase 3: Training
    ret = run_training_phase(args, env, config_path, launcher)
    if ret != 0:
        return ret

    # Printing handled by run_training_phase


    return 0


if __name__ == "__main__":
    sys.exit(main())
