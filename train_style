def run_training_phase(
    args: argparse.Namespace,
    env: dict,
    config_path: str,
    launcher: List[str],
) -> int:

    """Run the training phase using the generated configuration."""
    # pylint: disable=import-outside-toplevel
    from train.paths import get_style_support_dir

    support_dir = get_style_support_dir()
    # output_dir isn't used immediately here? Wait, let's look at 404 view.
    # It just continues to "Training Phase".
    # But look at line 682 in 405 view: output_dir = locations.get_style_output_dir().
    # Line 414 corruption replaced SOMETHING.
    # Previous code?
    # View 404 shows line 413: """Run the training phase..."""
    # So 414 was start of function body.
    # Was there `support_dir = ...` at start of body?
    # In Step 291 view, `run_training` (which became `run_training_phase`?) starts
    # So I should restore that (but with new import).
    output_dir = locations.get_style_output_dir()

    # Training Phase
    print("Starting training run...")

    train_args = [
        "-m",
        "scripts.train_style",
        "--config",
        config_path,
        "--embed-dim", str(args.embed_dim),
        "--hidden-dim", str(args.hidden_dim),
        "--num-layers", str(args.num_layers),
        "--num-heads", str(args.num_heads),
    ]

    # Always pass KC config params (KC is always enabled)
    train_args.extend([
        "--kc-k", str(args.kc_k),
        "--kc-topk", str(args.kc_topk),
    ])
    if args.kc_sparsity_weight is not None:
        train_args.extend(["--kc-sparsity-weight", str(args.kc_sparsity_weight)])
    if args.kc_freeze_encoder_epochs is not None:
        train_args.extend(["--kc-freeze-encoder-epochs", str(args.kc_freeze_encoder_epochs)])
    if args.kc_batch_size is not None:
        train_args.extend(["--kc-batch-size", str(args.kc_batch_size)])
    if args.kc_skip_first_metrics > 0:
        train_args.extend(["--kc-skip-first-metrics", str(args.kc_skip_first_metrics)])

    if args.retrain:
        train_args.append("--retrain")
    if args.percent:
        train_args.extend(["--percent", str(args.percent)])

    training_log = os.path.join(support_dir, "training.log")
    t_train_start = time.perf_counter()

    train_cmd = launcher + train_args
    ret = run_command(train_cmd, env, tee_log=training_log)

    print(f"Training run took {time.perf_counter() - t_train_start:.1f}s")
    if ret != 0:
        print("Training failed!", file=sys.stderr)
        return ret

    print()
    print("=" * 46)
    print("Training complete!")
    print(f"Model saved to: {output_dir}")
    print(f"Training log:   {training_log}")
    print("=" * 46)
    print()
    return 0


